
@inherits LayoutComponentBase
@inject NavigationManager Navigation

@if (estaNaTelaDeAcesso)
{
    <main>
        <article class="content px-4">
            @Body
        </article>
    </main>
}
else
{
    <div class="page @(menuAberto ? "menu-aberto" : "menu-fechado")">
        <div class="sidebar">
            <NavMenu AoAlternar="AtualizarMenu" />
        </div>

        <main>
            <div class="top-row px-4">
                <a href="https://learn.microsoft.com/aspnet/core/"
                   target="_blank">About</a>
            </div>

            <article class="content px-4">
                @Body
            </article>
        </main>
    </div>
}

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool menuAberto = true;

    private bool estaNaTelaDeAcesso =>
        Navigation.ToBaseRelativePath(Navigation.Uri)
            .Split('?')[0]
            .Trim('/')
            .ToLower() is "entrar" or "cadastro";

    private void AtualizarMenu(bool aberto)
    {
        menuAberto = aberto;
    }
}
