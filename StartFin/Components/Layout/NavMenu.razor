
@using Microsoft.AspNetCore.Components.Authorization

<div class="nav-menu-root @(menuAberto ? "menu-aberto" : "menu-fechado")">
    <div class="top-row ps-3 navbar navbar-dark">
        <div class="container-fluid">
            @if (menuAberto)
            {
                <a class="navbar-brand" href="">StartFin</a>
            }

            <button class="botao-menu @(menuAberto ? "aberto" : "fechado")"
                    type="button"
                    @onclick="AlternarMenu"
                    aria-label="Abrir ou fechar menu"
                    title="Abrir ou fechar menu">

                <span class="icone-menu" aria-hidden="true">
                    <span class="linha-menu"></span>
                </span>

                <span class="logo-recolhida" aria-hidden="true">$F</span>
            </button>
        </div>
    </div>

    <div class="nav-scrollable">
        <nav class="nav flex-column">

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                    <span class="icone-link">🏠</span>
                    <span class="texto-link">Menu</span>
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="metas">
                    <span class="icone-link">🎯</span>
                    <span class="texto-link">Metas</span>
                </NavLink>
            </div>

            <AuthorizeView>
                <Authorized>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="guardar-dinheiro">
                            <span class="icone-link">🐷</span>
                            <span class="texto-link">Guardar dinheiro</span>
                        </NavLink>
                    </div>
                </Authorized>
            </AuthorizeView>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="educacao-financeira">
                    <span class="icone-link">📚</span>
                    <span class="texto-link">Educação financeira</span>
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="desafios">
                    <span class="icone-link">🏆</span>
                    <span class="texto-link">Desafios</span>
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="conquistas">
                    <span class="icone-link">🏅</span>
                    <span class="texto-link">Conquistas</span>
                </NavLink>
            </div>

            <AuthorizeView Roles="Desenvolvedor">
                <Authorized>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="desenvolvedor">
                            <span class="icone-link">🛠️</span>
                            <span class="texto-link">Painel do Desenvolvedor</span>
                        </NavLink>
                    </div>
                </Authorized>
            </AuthorizeView>

            <AuthorizeView>
                <Authorized>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="nova-movimentacao">
                            <span class="icone-link">💸</span>
                            <span class="texto-link">Fazer movimentação</span>
                        </NavLink>
                    </div>

                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="movimentacoes">
                            <span class="icone-link">📋</span>
                            <span class="texto-link">Ver movimentações</span>
                        </NavLink>
                    </div>
                </Authorized>

                <NotAuthorized>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="Account/Login">
                            <span class="icone-link">🔐</span>
                            <span class="texto-link">Entrar</span>
                        </NavLink>
                    </div>
                </NotAuthorized>
            </AuthorizeView>

        </nav>
    </div>
</div>

@code {
    [Parameter]
    public EventCallback<bool> AoAlternar { get; set; }

    private bool menuAberto = true;

    private async Task AlternarMenu()
    {
        menuAberto = !menuAberto;
        await AoAlternar.InvokeAsync(menuAberto);
    }
}
