@page "/educacao-financeira/consumo-consciente"
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using System.Security.Claims
@using StartFin.Dados
@using StartFin.Modelos

@inject StartFinContext Context
@inject AuthenticationStateProvider AuthProvider

<PageTitle>Consumo consciente | StartFin</PageTitle>

<div class="aula-container">

    <a href="/educacao-financeira" class="voltar">← Voltar aos conteúdos</a>

    <header class="aula-cabecalho">
        <span class="etiqueta">EDUCAÇÃO FINANCEIRA • CONSUMO</span>
        <h1>Consumo consciente 🛍️</h1>
        <p>
            Aprenda a fazer escolhas melhores na hora de comprar,
            identificar necessidades e evitar gastos desnecessários.
        </p>
        <span class="nivel">Nível básico • Aula 5</span>
    </header>

    <section class="introducao">
        <h2>O que é consumo consciente?</h2>
        <p>
            Consumo consciente é pensar antes de comprar. Isso significa
            avaliar se realmente precisamos de um produto, se ele cabe
            no nosso orçamento e se existem alternativas melhores.
        </p>
        <p>
            Consumir conscientemente não significa deixar de comprar,
            mas utilizar o dinheiro com responsabilidade.
        </p>
    </section>

    <section class="conteudo-card">
        <h2>1. Necessidade ou desejo?</h2>
        <p>
            Antes de comprar alguma coisa, é importante entender
            a diferença entre necessidade e desejo.
        </p>

        <div class="exemplo">
            <h3>Necessidade</h3>
            <p>
                Algo importante para o nosso dia a dia, como alimentação,
                transporte e materiais escolares.
            </p>
        </div>

        <div class="exemplo">
            <h3>Desejo</h3>
            <p>
                Algo que queremos ter, mas que não é essencial,
                como um acessório novo ou um jogo.
            </p>
        </div>
    </section>

    <section class="conteudo-card">
        <h2>2. Cuidado com compras por impulso</h2>
        <p>
            Compras por impulso acontecem quando adquirimos algo
            sem pensar direito, muitas vezes motivados por promoções,
            propagandas ou vontade momentânea.
        </p>

        <div class="dica">
            <strong>Dica:</strong>
            Antes de comprar, espere um pouco e pergunte:
            "Eu realmente preciso disso? Essa compra cabe no meu orçamento?"
        </div>
    </section>

    <section class="conteudo-card">
        <h2>3. Compare preços antes de comprar</h2>
        <p>
            Pesquisar em diferentes lojas ajuda a encontrar melhores
            condições e evitar pagar mais caro pelo mesmo produto.
        </p>

        <div class="exemplo">
            <h3>Exemplo prático</h3>
            <p>
                Uma mochila custa R$ 150,00 em uma loja e R$ 120,00
                em outra. Comparando os preços, você pode economizar
                R$ 30,00.
            </p>
        </div>
    </section>

    <section class="conteudo-card">
        <h2>4. Promoção nem sempre significa economia</h2>
        <p>
            Um produto com desconto não representa necessariamente
            uma boa compra. Se você não precisa dele, ainda estará
            gastando dinheiro sem necessidade.
        </p>
        <div class="dica">
            <strong>Lembre-se:</strong>
            O melhor negócio é aquele que faz sentido para sua necessidade
            e para seu orçamento.
        </div>
    </section>

    <section class="conteudo-card">
        <h2>5. Planeje suas compras</h2>
        <p>
            Fazer uma lista antes de sair para comprar ajuda a manter
            o foco e evitar gastos que não estavam planejados.
        </p>

        <ul>
            <li>Defina o que realmente precisa comprar.</li>
            <li>Estabeleça um limite de gastos.</li>
            <li>Pesquise preços e condições.</li>
            <li>Evite comprar apenas porque algo está em promoção.</li>
            <li>Confira se a compra não prejudica suas outras metas.</li>
        </ul>
    </section>

    <section class="resumo">
        <h2>O que aprendemos?</h2>
        <ul>
            <li>Consumo consciente envolve pensar antes de comprar.</li>
            <li>Necessidades são diferentes de desejos.</li>
            <li>Compras por impulso podem prejudicar o orçamento.</li>
            <li>Comparar preços ajuda a economizar.</li>
            <li>Planejar compras permite tomar decisões melhores.</li>
        </ul>
    </section>

    <section class="quiz-card">
        <span class="etiqueta">TESTE SEUS CONHECIMENTOS</span>
        <h2>Hora de praticar! 🧠</h2>
        <p>
            Responda a 10 questões sobre consumo consciente
            e veja quanto você aprendeu nesta aula.
        </p>

        <a href="/educacao-financeira/quiz/consumo-consciente" class="botao-quiz">
            Fazer quiz →
        </a>

        <button type="button" class="botao-resultado" @onclick="MostrarUltimoResultado">
            Ver último resultado
        </button>

        @if (ExibindoUltimoResultado)
        {
            <div class="resultado-ultimo">
                @if (UltimoResultado != null)
                {
                    <h3>Seu último resultado</h3>

                    <p>
                        Você acertou
                        <strong>@UltimoResultado.Pontos de @UltimoResultado.TotalPerguntas</strong>
                        questões.
                    </p>

                    <p>
                        Concluído em:
                        @UltimoResultado.DataConclusao?.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                    </p>
                }
                else
                {
                <p>Você ainda não concluiu este quiz.</p>
                }
            </div>
        }
    </section>

</div>

@code {
    private ResultadoQuiz? UltimoResultado;
    private bool ExibindoUltimoResultado = false;

    private async Task MostrarUltimoResultado()
    {
        var estado = await AuthProvider.GetAuthenticationStateAsync();
        var usuarioId = estado.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        if (string.IsNullOrEmpty(usuarioId))
        {
            UltimoResultado = null;
            ExibindoUltimoResultado = true;
            return;
        }

        UltimoResultado = await Context.ResultadosQuiz
            .Where(r => r.UsuarioId == usuarioId &&
                r.IdentificadorQuiz == "consumo-consciente" &&
                r.Status == "Concluída")
            .OrderByDescending(r => r.DataConclusao)
            .FirstOrDefaultAsync();

        ExibindoUltimoResultado = true;
    }
}

<style>
    .aula-container {
        max-width: 850px;
        margin: 35px auto;
        padding: 20px;
        color: #172033;
    }

    .voltar {
        color: #087f5b;
        text-decoration: none;
        font-weight: 700;
    }

    .aula-cabecalho {
        margin: 30px 0;
    }

    .etiqueta {
        color: #087f5b;
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 1px;
    }

    .aula-cabecalho h1 {
        font-size: 32px;
        margin: 10px 0;
    }

    .aula-cabecalho p {
        color: #64748b;
        line-height: 1.6;
    }

    .nivel {
        display: inline-block;
        margin-top: 10px;
        padding: 7px 12px;
        background: #ecfdf5;
        color: #087f5b;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 700;
    }

    .introducao, .conteudo-card, .resumo, .quiz-card {
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        padding: 25px;
        margin-bottom: 20px;
        box-shadow: 0 5px 20px #00000008;
    }

    .introducao h2, .conteudo-card h2,
    .resumo h2, .quiz-card h2 {
        color: #172b65;
        font-size: 21px;
        margin-bottom: 14px;
    }

    .introducao p, .conteudo-card p,
    .resumo li, .quiz-card p {
        color: #475569;
        line-height: 1.7;
    }

    .exemplo {
        background: #f0fdf4;
        border-left: 4px solid #10b981;
        padding: 16px;
        border-radius: 8px;
        margin-top: 15px;
    }

    .exemplo h3 {
        color: #087f5b;
        font-size: 16px;
        margin-bottom: 8px;
    }

    .exemplo p {
        margin-bottom: 0;
    }

    .dica {
        background: #eff6ff;
        border-left: 4px solid #3b82f6;
        padding: 16px;
        border-radius: 8px;
        margin-top: 15px;
        color: #1e40af;
        line-height: 1.7;
    }

    .conteudo-card ul, .resumo ul {
        padding-left: 22px;
        line-height: 1.9;
        color: #475569;
    }

    .quiz-card {
        text-align: center;
        background: #f0fdf4;
        border-color: #bbf7d0;
        padding: 30px;
    }

    .botao-quiz {
        display: inline-block;
        margin-top: 15px;
        padding: 13px 25px;
        background: #087f5b;
        color: white;
        text-decoration: none;
        border-radius: 10px;
        font-weight: 700;
    }

    .botao-quiz:hover {
        background: #066849;
        color: white;
    }

    .botao-resultado {
    display: block;
    margin: 15px auto 0;
    padding: 12px 22px;
    border: 1px solid #2455a4;
    border-radius: 10px;
    background: white;
    color: #2455a4;
    font-weight: bold;
    cursor: pointer;
    }

    .botao-resultado:hover {
    background: #eff6ff;
    }

    .resultado-ultimo {
    margin-top: 20px;
    padding: 18px;
    background: white;
    border: 1px solid #bbf7d0;
    border-radius: 12px;
    color: #475569;
    }

    .resultado-ultimo h3 {
    color: #087f5b;
    margin-bottom: 12px;
    }

    @@media (max-width: 600px) {
        .aula-cabecalho h1 {
            font-size: 26px;
        }

        .introducao, .conteudo-card,
        .resumo, .quiz-card {
            padding: 20px;
        }
    }
</style>