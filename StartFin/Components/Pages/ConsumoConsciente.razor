@page "/educacao-financeira/consumo-consciente"

@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using System.Security.Claims
@using System.Text.Json
@using StartFin.Dados
@using StartFin.Modelos

@inject StartFinContext Context
@inject AuthenticationStateProvider AuthProvider

<PageTitle>Consumo consciente | StartFin</PageTitle>

<div class="aula-container">

    <a href="/educacao-financeira" class="voltar">← Voltar aos conteúdos</a>

    <header class="aula-cabecalho">
        <span class="etiqueta">EDUCAÇÃO FINANCEIRA • CONSUMO</span>
        <h1>Consumo consciente 🛍️</h1>
        <p>
            Aprenda a fazer escolhas melhores na hora de comprar,
            identificar necessidades e evitar gastos desnecessários.
        </p>
        <span class="nivel">Nível básico • Aula 5</span>
    </header>

    <section class="introducao">
        <h2>O que é consumo consciente?</h2>
        <p>
            Consumo consciente é pensar antes de comprar. Isso significa
            avaliar se realmente precisamos de um produto, se ele cabe
            no nosso orçamento e se existem alternativas melhores.
        </p>
        <p>
            Consumir conscientemente não significa deixar de comprar,
            mas utilizar o dinheiro com responsabilidade.
        </p>
    </section>

    <section class="conteudo-card">
        <h2>1. Necessidade ou desejo?</h2>
        <p>
            Antes de comprar alguma coisa, é importante entender
            a diferença entre necessidade e desejo.
        </p>

        <div class="exemplo">
            <h3>Necessidade</h3>
            <p>
                Algo importante para o nosso dia a dia, como alimentação,
                transporte e materiais escolares.
            </p>
        </div>

        <div class="exemplo">
            <h3>Desejo</h3>
            <p>
                Algo que queremos ter, mas que não é essencial,
                como um acessório novo ou um jogo.
            </p>
        </div>
    </section>

    <section class="conteudo-card">
        <h2>2. Cuidado com compras por impulso</h2>
        <p>
            Compras por impulso acontecem quando adquirimos algo
            sem pensar direito, muitas vezes motivados por promoções,
            propagandas ou vontade momentânea.
        </p>

        <div class="dica">
            <strong>Dica:</strong>
            Antes de comprar, espere um pouco e pergunte:
            "Eu realmente preciso disso? Essa compra cabe no meu orçamento?"
        </div>
    </section>

    <section class="conteudo-card">
        <h2>3. Compare preços antes de comprar</h2>
        <p>
            Pesquisar em diferentes lojas ajuda a encontrar melhores
            condições e evitar pagar mais caro pelo mesmo produto.
        </p>

        <div class="exemplo">
            <h3>Exemplo prático</h3>
            <p>
                Uma mochila custa R$ 150,00 em uma loja e R$ 120,00
                em outra. Comparando os preços, você pode economizar
                R$ 30,00.
            </p>
        </div>
    </section>

    <section class="conteudo-card">
        <h2>4. Promoção nem sempre significa economia</h2>
        <p>
            Um produto com desconto não representa necessariamente
            uma boa compra. Se você não precisa dele, ainda estará
            gastando dinheiro sem necessidade.
        </p>
        <div class="dica">
            <strong>Lembre-se:</strong>
            O melhor negócio é aquele que faz sentido para sua necessidade
            e para seu orçamento.
        </div>
    </section>

    <section class="conteudo-card">
        <h2>5. Planeje suas compras</h2>
        <p>
            Fazer uma lista antes de sair para comprar ajuda a manter
            o foco e evitar gastos que não estavam planejados.
        </p>

        <ul>
            <li>Defina o que realmente precisa comprar.</li>
            <li>Estabeleça um limite de gastos.</li>
            <li>Pesquise preços e condições.</li>
            <li>Evite comprar apenas porque algo está em promoção.</li>
            <li>Confira se a compra não prejudica suas outras metas.</li>
        </ul>
    </section>

    <section class="resumo">
        <h2>O que aprendemos?</h2>
        <ul>
            <li>Consumo consciente envolve pensar antes de comprar.</li>
            <li>Necessidades são diferentes de desejos.</li>
            <li>Compras por impulso podem prejudicar o orçamento.</li>
            <li>Comparar preços ajuda a economizar.</li>
            <li>Planejar compras permite tomar decisões melhores.</li>
        </ul>
    </section>

    <section class="quiz-card">
        <span class="etiqueta">TESTE SEUS CONHECIMENTOS</span>
        <h2>Hora de praticar! 🧠</h2>
        <p>
            Responda a 10 questões sobre consumo consciente
            e veja quanto você aprendeu nesta aula.
        </p>

        <a href="/educacao-financeira/quiz/consumo-consciente" class="botao-quiz">
            Fazer quiz →
        </a>

        <button type="button" class="botao-resultado" @onclick="ConsultarResultado">
            Ver resultados do quiz
        </button>

        @if (MostrarResultado)
        {
            <div class="area-resultado">
                @if (Carregando)
                {
                    <p>Carregando resultados...</p>
                }
                else if (TentativaEmAndamento != null)
                {
                    <div class="progresso-pendente">
                        <h3>🚀 Você ainda não terminou!</h3>

                        <p>
                            Existe uma tentativa deste quiz em andamento.
                            Continue de onde parou para concluir suas questões.
                        </p>

                        <div class="estatisticas-progresso">
                            <div class="estatistica-progresso">
                                <strong>@PerguntasRespondidas/@TentativaEmAndamento.TotalPerguntas</strong>
                                <span>Respondidas</span>
                            </div>

                            <div class="estatistica-progresso">
                                <strong>@PerguntasRestantes</strong>
                                <span>Restantes</span>
                            </div>

                            <div class="estatistica-progresso">
                                <strong>@TentativaEmAndamento.Pontos</strong>
                                <span>Acertos</span>
                            </div>
                        </div>

                        <div class="barra-progresso-quiz">
                            <div class="barra-progresso-preenchida"
                                 style="width: @PercentualProgresso.ToString(System.Globalization.CultureInfo.InvariantCulture)%">
                            </div>
                        </div>

                        <p class="mensagem-incentivo">
                            Você parou na pergunta @PerguntaAtual de @TentativaEmAndamento.TotalPerguntas.
                        </p>

                        <a href="/educacao-financeira/quiz/consumo-consciente" class="botao-continuar">
                            Continuar de onde parei →
                        </a>
                    </div>
                }
                else if (UltimoResultado != null)
                {
                    <div class="resultado-concluido">
                        <h3>🏆 Seu último resultado concluído</h3>

                        <div class="pontuacao-resultado">
                            @UltimoResultado.Pontos
                            <small>/ @UltimoResultado.TotalPerguntas</small>
                        </div>

                        <p>
                            Você acertou @UltimoResultado.Pontos de
                            @UltimoResultado.TotalPerguntas questões.
                        </p>

                        <p>
                            Concluído em:
                            @UltimoResultado.DataConclusao?.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                        </p>

                        <p class="mensagem-incentivo">
                            Continue aprendendo e desenvolvendo seus conhecimentos financeiros!
                        </p>
                    </div>
                }
                else
                {
                    <div class="resultado-vazio">
                        <p>Você ainda não iniciou ou concluiu este quiz.</p>
                        <p>Comece agora e teste seus conhecimentos!</p>
                    </div>
                }
            </div>
        }
    </section>

</div>

@code {
    private ResultadoQuiz? UltimoResultado;
    private ResultadoQuiz? TentativaEmAndamento;

    private bool MostrarResultado = false;
    private bool Carregando = false;

    private int PerguntasRespondidas = 0;
    private int PerguntasRestantes = 10;
    private int PerguntaAtual = 1;

    private int PercentualProgresso =>
        TentativaEmAndamento == null || TentativaEmAndamento.TotalPerguntas <= 0
            ? 0
            : Math.Clamp(
                PerguntasRespondidas * 100 / TentativaEmAndamento.TotalPerguntas,
                0,
                100);

    private async Task ConsultarResultado()
    {
        MostrarResultado = true;
        Carregando = true;

        UltimoResultado = null;
        TentativaEmAndamento = null;

        PerguntasRespondidas = 0;
        PerguntasRestantes = 10;
        PerguntaAtual = 1;

        try
        {
            var estado = await AuthProvider.GetAuthenticationStateAsync();
            var usuarioId = estado.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;

            if (string.IsNullOrEmpty(usuarioId))
                return;

            TentativaEmAndamento = await Context.ResultadosQuiz
                .AsNoTracking()
                .Where(r =>
                    r.UsuarioId == usuarioId &&
                    r.IdentificadorQuiz == "consumo-consciente" &&
                    r.Status == "Em andamento")
                .OrderByDescending(r => r.DataInicio)
                .FirstOrDefaultAsync();

            UltimoResultado = await Context.ResultadosQuiz
                .AsNoTracking()
                .Where(r =>
                    r.UsuarioId == usuarioId &&
                    r.IdentificadorQuiz == "consumo-consciente" &&
                    r.Status == "Concluída")
                .OrderByDescending(r => r.DataConclusao)
                .FirstOrDefaultAsync();

            if (TentativaEmAndamento != null)
            {
                var progresso = JsonSerializer.Deserialize<ProgressoQuiz>(
                    TentativaEmAndamento.RespostasJson ?? "{}");

                if (progresso != null)
                {
                    PerguntasRespondidas = progresso.Indice +
                        (progresso.Respondida ? 1 : 0);

                    PerguntasRespondidas = Math.Clamp(
                        PerguntasRespondidas,
                        0,
                        TentativaEmAndamento.TotalPerguntas);

                    PerguntasRestantes = Math.Max(
                        0,
                        TentativaEmAndamento.TotalPerguntas - PerguntasRespondidas);

                    PerguntaAtual = Math.Min(
                        progresso.Indice + 1,
                        TentativaEmAndamento.TotalPerguntas);
                }
            }
        }
        catch
        {
            TentativaEmAndamento = null;
            UltimoResultado = null;
        }
        finally
        {
            Carregando = false;
        }
    }

    private class ProgressoQuiz
    {
        public int Indice { get; set; }
        public int Pontos { get; set; }
        public bool Respondida { get; set; }
        public bool Acertou { get; set; }
        public string Selecionada { get; set; } = string.Empty;
    }
}

