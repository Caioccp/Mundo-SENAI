
@page "/educacao-financeira/quiz/comecando-do-zero"

@using Microsoft.AspNetCore.Components.Authorization
@using StartFin.Dados
@using StartFin.Modelos
@using System.Security.Claims

@inject StartFinContext Context
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Quiz - Começando do zero | StartFin</PageTitle>

<div class="quiz-container">

    <a href="/educacao-financeira/comecando-do-zero" class="voltar">
        ← Voltar para a aula
    </a>

    <div class="cabecalho">
        <span class="etiqueta">STARTFIN • EDUCAÇÃO FINANCEIRA</span>
        <h1>Quiz: Começando do zero</h1>
        <p>
            Agora é hora de aplicar seus conhecimentos em situações reais.
            Leia com atenção antes de responder!
        </p>
        <span class="nivel">Nível intermediário • 10 questões</span>
    </div>

    @if (!Finalizado)
    {
        <div class="progresso">
            <div class="progresso-texto">
                <span>Pergunta @(Indice + 1) de @Perguntas.Count</span>
                <span>@Pontos pontos</span>
            </div>

            <div class="barra">
                <div class="barra-preenchida"
                     style="width: @(((Indice + 1) * 100.0 / Perguntas.Count).ToString(System.Globalization.CultureInfo.InvariantCulture))%">
                </div>
            </div>
        </div>

        <section class="pergunta-card">

            <span class="numero">QUESTÃO @(Indice + 1)</span>

            <h2>@Perguntas[Indice].Enunciado</h2>

            <div class="opcoes">
                @foreach (var opcao in Perguntas[Indice].Opcoes)
                {
                    <button class="opcao @(Selecionada == opcao ? "selecionada" : "")"
                            disabled="@Respondida"
                            @onclick="() => Selecionar(opcao)">
                        @opcao
                    </button>
                }
            </div>

            @if (Respondida)
            {
                <div class="feedback @(Acertou ? "correto" : "incorreto")">
                    <strong>
                        @(Acertou ? "Resposta correta!" : "Resposta incorreta!")
                    </strong>
                    <p>@Perguntas[Indice].Explicacao</p>
                </div>
            }

            <div class="acoes">
                @if (!Respondida)
                {
                    <button class="botao-principal"
                            disabled="@string.IsNullOrEmpty(Selecionada)"
                            @onclick="ConfirmarResposta">
                        Confirmar resposta
                    </button>
                }
                else
                {
                    <button class="botao-principal" @onclick="Proxima">
                        @(Indice == Perguntas.Count - 1
                            ? "Ver resultado"
                            : "Próxima pergunta")
                    </button>
                }
            </div>

        </section>
    }
    else
    {
        <section class="resultado-card">

            <span class="etiqueta">QUIZ CONCLUÍDO</span>
            <h2>Você terminou!</h2>

            <div class="pontuacao">
                @Pontos <small>/ @Perguntas.Count</small>
            </div>

            <p>Você acertou @Pontos de @Perguntas.Count perguntas.</p>

            <p class="mensagem">@MensagemResultado</p>

            @if (ResultadoSalvo)
            {
                <p class="salvo">
                    ✓ Seu resultado foi salvo na sua conta!
                </p>
            }
            else
            {
                <p class="aviso">@MensagemSalvamento</p>
            }

            <button class="botao-principal" @onclick="Reiniciar">
                Refazer quiz
            </button>

            <a href="/educacao-financeira/comecando-do-zero" class="link-aula">
                Voltar para a aula
            </a>

        </section>
    }

</div>

<style>
    .quiz-container {
        max-width: 850px;
        margin: 35px auto;
        padding: 20px;
        color: #172033;
    }

    .voltar, .link-aula {
        color: #087f5b;
        text-decoration: none;
        font-weight: 700;
    }

    .cabecalho {
        margin: 30px 0;
    }

    .etiqueta, .numero {
        color: #087f5b;
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 1px;
    }

    .cabecalho h1 {
        font-size: 32px;
        margin: 10px 0;
    }

    .cabecalho p {
        color: #64748b;
        line-height: 1.6;
    }

    .nivel {
        display: inline-block;
        margin-top: 10px;
        padding: 7px 12px;
        background: #ecfdf5;
        color: #087f5b;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 700;
    }

    .progresso {
        margin-bottom: 20px;
    }

    .progresso-texto {
        display: flex;
        justify-content: space-between;
        margin-bottom: 8px;
        font-weight: 700;
    }

    .barra {
        height: 9px;
        background: #e2e8f0;
        border-radius: 20px;
        overflow: hidden;
    }

    .barra-preenchida {
        height: 100%;
        background: #10b981;
        border-radius: 20px;
        transition: width .3s;
    }

    .pergunta-card, .resultado-card {
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 18px;
        padding: 30px;
        box-shadow: 0 5px 20px #00000008;
    }

    .pergunta-card h2 {
        font-size: 22px;
        line-height: 1.6;
        margin: 15px 0 25px;
    }

    .opcoes {
        display: grid;
        gap: 12px;
    }

    .opcao {
        width: 100%;
        text-align: left;
        padding: 16px;
        border: 1px solid #cbd5e1;
        border-radius: 12px;
        background: white;
        color: #172033;
        cursor: pointer;
        font-size: 15px;
        line-height: 1.5;
        transition: .2s;
    }

    .opcao:hover:not(:disabled) {
        border-color: #10b981;
        background: #f0fdf4;
    }

    .opcao.selecionada {
        border: 2px solid #059669;
        background: #ecfdf5;
    }

    .opcao:disabled {
        cursor: default;
        opacity: 1;
    }

    .feedback {
        margin-top: 20px;
        padding: 16px;
        border-radius: 12px;
        line-height: 1.6;
    }

    .feedback p {
        margin-bottom: 0;
    }

    .correto {
        background: #dcfce7;
        color: #166534;
    }

    .incorreto {
        background: #fee2e2;
        color: #991b1b;
    }

    .acoes {
        margin-top: 25px;
        display: flex;
        justify-content: flex-end;
    }

    .botao-principal {
        border: none;
        border-radius: 10px;
        padding: 14px 24px;
        background: #087f5b;
        color: white;
        font-weight: 700;
        cursor: pointer;
        font-size: 15px;
    }

    .botao-principal:hover {
        background: #066849;
    }

    .botao-principal:disabled {
        background: #94a3b8;
        cursor: not-allowed;
    }

    .resultado-card {
        text-align: center;
        padding: 45px 25px;
    }

    .resultado-card h2 {
        font-size: 28px;
    }

    .pontuacao {
        font-size: 65px;
        font-weight: 800;
        color: #087f5b;
        margin: 15px 0;
    }

    .pontuacao small {
        font-size: 25px;
        color: #64748b;
    }

    .mensagem {
        margin: 20px 0;
        color: #475569;
    }

    .salvo {
        color: #087f5b;
        font-weight: 700;
    }

    .aviso {
        color: #b45309;
    }

    .resultado-card .botao-principal {
        display: block;
        margin: 25px auto 15px;
    }

    @@media (max-width: 600px) {
        .cabecalho h1 {
            font-size: 26px;
        }

        .pergunta-card {
            padding: 20px;
        }

        .pergunta-card h2 {
            font-size: 19px;
        }
    }
</style>

@code {
    private int Indice = 0;
    private int Pontos = 0;

    private bool Respondida = false;
    private bool Acertou = false;
    private bool Finalizado = false;
    private bool ResultadoSalvo = false;

    private string Selecionada = string.Empty;
    private string MensagemResultado = string.Empty;
    private string MensagemSalvamento = string.Empty;

    private List<Pergunta> Perguntas = new()
{
    new(
        "Lucas recebe R$ 300,00 por mês. Seus gastos somam R$ 270,00, mas ele quer economizar R$ 60,00. Qual seria a melhor decisão?",
        new()
        {
            "Usar o limite de crédito para completar a economia.",
            "Reduzir ou reorganizar os gastos em R$ 30,00.",
            "Ignorar o planejamento e manter os mesmos gastos.",
            "Gastar menos apenas quando receber dinheiro extra."
        },
        "Lucas precisa economizar R$ 30,00 além do que atualmente sobra. Reorganizar os gastos permite alcançar a meta sem depender de dinheiro extra.",
        "Reduzir ou reorganizar os gastos em R$ 30,00."
    ),

    new(
        "Mariana encontrou um produto por R$ 240,00 à vista ou em 6 parcelas de R$ 44,00. Qual análise está correta?",
        new()
        {
            "As parcelas são melhores porque dividem o pagamento.",
            "As duas opções possuem exatamente o mesmo custo.",
            "O parcelamento é vantajoso independentemente do orçamento.",
            "À vista custa R$ 240,00, enquanto parcelado custa R$ 264,00."
        },
        "Seis parcelas de R$ 44,00 totalizam R$ 264,00. Portanto, o parcelamento custa R$ 24,00 a mais.",
        "À vista custa R$ 240,00, enquanto parcelado custa R$ 264,00."
    ),

    new(
        "Pedro guardou R$ 500,00 para comprar um computador. Surgiu uma promoção de outro produto que ele não precisava. Qual conceito ajuda a avaliar essa escolha?",
        new()
        {
            "Custo de oportunidade, considerando o objetivo que seria adiado.",
            "Renda fixa, considerando apenas o dinheiro recebido.",
            "Inflação, considerando somente a variação dos preços.",
            "Crédito pessoal, considerando o limite disponível."
        },
        "O custo de oportunidade representa aquilo de que abrimos mão ao escolher uma alternativa. Comprar outro produto pode atrasar a aquisição do computador.",
        "Custo de oportunidade, considerando o objetivo que seria adiado."
    ),

    new(
        "Ana recebe R$ 400,00 e decide separar R$ 40,00 assim que recebe. Qual é a principal vantagem dessa estratégia?",
        new()
        {
            "Ela elimina a necessidade de controlar despesas.",
            "Ela garante que todos os preços permaneçam iguais.",
            "Ela transforma a economia em uma prioridade do orçamento.",
            "Ela permite gastar sem considerar o saldo disponível."
        },
        "Separar uma quantia logo no recebimento ajuda a priorizar a economia, em vez de depender apenas do dinheiro que sobra.",
        "Ela transforma a economia em uma prioridade do orçamento."
    ),

    new(
        "Rafael percebeu que pequenas compras frequentes representam R$ 90,00 de seus gastos mensais. O que essa informação permite concluir?",
        new()
        {
            "Pequenos gastos não precisam entrar no orçamento.",
            "Despesas frequentes também podem comprometer o planejamento.",
            "Somente compras parceladas afetam o saldo mensal.",
            "O valor de cada compra é mais importante que a frequência."
        },
        "Mesmo quando cada compra parece barata, a repetição pode gerar um gasto mensal significativo.",
        "Despesas frequentes também podem comprometer o planejamento."
    ),

    new(
        "Beatriz quer montar uma reserva para despesas inesperadas. Qual característica é mais importante para esse dinheiro?",
        new()
        {
            "Ficar disponível somente depois de vários anos.",
            "Ser utilizado para compras planejadas de lazer.",
            "Ter seu valor comprometido com parcelas futuras.",
            "Permitir acesso quando surgir uma necessidade imprevista."
        },
        "Uma reserva financeira serve para lidar com situações inesperadas. Por isso, a possibilidade de acesso ao dinheiro é importante.",
        "Permitir acesso quando surgir uma necessidade imprevista."
    ),

    new(
        "João tem uma meta de R$ 800,00 e já guardou R$ 320,00. Qual percentual da meta ele alcançou?",
        new()
        {
            "40% da quantia estabelecida como objetivo.",
            "32% da quantia estabelecida como objetivo.",
            "48% da quantia estabelecida como objetivo.",
            "60% da quantia estabelecida como objetivo."
        },
        "Dividindo 320 por 800 e multiplicando por 100, temos 40%. João já alcançou essa parte da meta.",
        "40% da quantia estabelecida como objetivo."
    ),

    new(
        "Camila recebe R$ 600,00 e gasta R$ 250,00 com necessidades, R$ 150,00 com lazer e R$ 100,00 com outros gastos. Quanto ainda pode destinar a uma meta?",
        new()
        {
            "R$ 50,00, considerando apenas os gastos necessários.",
            "R$ 150,00, considerando todos os valores recebidos.",
            "R$ 100,00, considerando o saldo após as despesas.",
            "R$ 200,00, considerando somente os gastos de lazer."
        },
        "Somando os gastos, temos R$ 500,00. Subtraindo esse valor dos R$ 600,00 recebidos, sobram R$ 100,00.",
        "R$ 100,00, considerando o saldo após as despesas."
    ),

    new(
        "Eduardo percebeu que seus gastos aumentaram, embora continue recebendo a mesma quantia. Qual atitude ajuda a identificar o problema?",
        new()
        {
            "Aumentar as compras para aproveitar o dinheiro recebido.",
            "Deixar de registrar despesas de pequeno valor.",
            "Considerar somente os gastos realizados no cartão.",
            "Comparar os registros atuais com os meses anteriores."
        },
        "Comparar os registros permite identificar quais despesas aumentaram e quais mudanças podem ser feitas no orçamento.",
        "Comparar os registros atuais com os meses anteriores."
    ),

    new(
        "Sofia deseja comprar um fone de R$ 360,00. Ela consegue guardar R$ 60,00 por mês. Se não retirar dinheiro da economia, em quanto tempo alcançará a meta?",
        new()
        {
            "Em quatro meses de economia contínua.",
            "Em seis meses de economia contínua.",
            "Em cinco meses de economia contínua.",
            "Em oito meses de economia contínua."
        },
        "Dividindo R$ 360,00 por R$ 60,00, descobrimos que Sofia precisará de seis meses para alcançar o objetivo.",
        "Em seis meses de economia contínua."
    )
};

    private void Selecionar(string opcao)
    {
        if (!Respondida)
        {
            Selecionada = opcao;
        }
    }

    private void ConfirmarResposta()
    {
        if (string.IsNullOrEmpty(Selecionada) || Respondida)
            return;

        Acertou = Selecionada == Perguntas[Indice].RespostaCorreta;

        if (Acertou)
            Pontos++;

        Respondida = true;
    }

    private async Task Proxima()
    {
        if (Indice < Perguntas.Count - 1)
        {
            Indice++;
            Selecionada = string.Empty;
            Respondida = false;
            Acertou = false;
        }
        else
        {
            Finalizado = true;

            MensagemResultado = Pontos switch
            {
                10 => "Excelente! Você demonstrou domínio dos conceitos e das situações financeiras apresentadas.",
                >= 8 => "Muito bom! Você conseguiu aplicar a maioria dos conceitos financeiros corretamente.",
                >= 6 => "Bom esforço! Você já compreende vários conceitos, mas ainda pode melhorar.",
                _ => "Continue praticando! Revise a aula e tente novamente para fortalecer seus conhecimentos."
            };

            await SalvarResultadoAsync();
        }
    }

    private async Task SalvarResultadoAsync()
    {
        try
        {
            var estado = await AuthenticationStateProvider.GetAuthenticationStateAsync();

            var usuarioId = estado.User.FindFirst(
                ClaimTypes.NameIdentifier)?.Value;

            if (string.IsNullOrEmpty(usuarioId))
            {
                MensagemSalvamento = "Entre na sua conta para salvar seu resultado.";
                return;
            }

            var resultado = new ResultadoQuiz
            {
                UsuarioId = usuarioId,
                IdentificadorQuiz = "comecando-do-zero",
                Pontos = Pontos,
                TotalPerguntas = Perguntas.Count,
                DataConclusao = DateTime.UtcNow
            };

            Context.ResultadosQuiz.Add(resultado);
            await Context.SaveChangesAsync();

            ResultadoSalvo = true;
        }
        catch
        {
            MensagemSalvamento = "Não foi possível salvar o resultado. Tente novamente mais tarde.";
        }
    }

    private void Reiniciar()
    {
        Indice = 0;
        Pontos = 0;
        Respondida = false;
        Acertou = false;
        Finalizado = false;
        ResultadoSalvo = false;

        Selecionada = string.Empty;
        MensagemResultado = string.Empty;
        MensagemSalvamento = string.Empty;
    }

    private class Pergunta
    {
        public string Enunciado { get; set; }
        public List<string> Opcoes { get; set; }
        public string Explicacao { get; set; }
        public string RespostaCorreta { get; set; }

        public Pergunta(
            string enunciado,
            List<string> opcoes,
            string explicacao,
            string respostaCorreta)
        {
            Enunciado = enunciado;
            Opcoes = opcoes;
            Explicacao = explicacao;
            RespostaCorreta = respostaCorreta;
        }
    }
}
