            new()
            {
                "R$ 30",
                "R$ 40",
                "R$ 50",
                "R$ 60"
            },
            "20% de R$ 300 corresponde a R$ 60. Uma forma de calcular é dividir 300 por 100 e multiplicar por 20.",
            "R$ 60"
        ),

        new(
            "Ana tem R$ 150 disponíveis. Ela precisa comprar material escolar por R$ 65 e também quer comprar um acessório de R$ 100. Qual decisão demonstra melhor planejamento financeiro?",
            new()
            {
                "Comprar o acessório e deixar o material para depois.",
                "Comprar o material e avaliar se o acessório pode esperar.",
                "Gastar os R$ 150 sem comparar prioridades.",
                "Pedir dinheiro emprestado para comprar os dois imediatamente."
            },
            "O material escolar representa uma necessidade importante. Ana deve priorizá-lo e avaliar o acessório sem comprometer seu orçamento.",
            "Comprar o material e avaliar se o acessório pode esperar."
        ),

        new(
            "Uma loja vende um produto por R$ 120. Outra loja vende o mesmo produto por R$ 105, mas cobra R$ 12 de entrega. Qual opção apresenta o menor custo total?",
            new()
            {
                "A primeira loja, por R$ 120.",
                "A segunda loja, por R$ 117.",
                "As duas lojas têm o mesmo custo.",
                "A segunda loja, por R$ 105."
            },
            "Na segunda loja, o total é R$ 105 + R$ 12 = R$ 117. Portanto, ela custa R$ 3 a menos que a primeira.",
            "A segunda loja, por R$ 117."
        ),

        new(
            "João recebe R$ 500 e termina o mês com R$ 50. Qual porcentagem da renda ele conseguiu economizar?",
            new()
            {
                "5%",
                "10%",
                "15%",
                "20%"
            },
            "R$ 50 representa 10% de R$ 500, pois 50 dividido por 500 é igual a 0,10.",
            "10%"
        ),

        new(
            "Beatriz recebe R$ 350. Suas despesas são: R$ 100 com transporte, R$ 90 com alimentação e R$ 60 com outras necessidades. Ela quer guardar R$ 70. Quanto restará para outros gastos depois de separar tudo isso?",
            new()
            {
                "R$ 20",
                "R$ 30",
                "R$ 40",
                "R$ 50"
            },
            "As despesas e a economia somam R$ 320. Subtraindo de R$ 350, restam R$ 30.",
            "R$ 30"
        ),

        new(
            "Rafael anotou seus gastos durante o mês e percebeu que gastou R$ 90 em compras por impulso. Qual seria a atitude mais adequada para melhorar seu planejamento no mês seguinte?",
            new()
            {
                "Ignorar os gastos porque já aconteceram.",
                "Aumentar as compras para aproveitar o dinheiro.",
                "Identificar esses gastos e estabelecer um limite para compras não planejadas.",
                "Deixar de registrar as despesas menores."
            },
            "Analisar os gastos permite identificar hábitos que podem ser melhorados e estabelecer limites mais conscientes.",
            "Identificar esses gastos e estabelecer um limite para compras não planejadas."
        ),

        new(
            "Camila quer comprar um tablet de R$ 900. Ela já tem R$ 300 guardados e consegue economizar R$ 100 por mês. Em quantos meses terá o valor necessário?",
            new()
            {
                "4 meses",
                "5 meses",
                "6 meses",
                "9 meses"
            },
            "Faltam R$ 600 para chegar aos R$ 900. Guardando R$ 100 por mês, Camila precisará de mais 6 meses.",
            "6 meses"
