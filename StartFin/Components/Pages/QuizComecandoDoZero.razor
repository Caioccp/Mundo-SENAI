
@page "/educacao-financeira/quiz/comecando-do-zero"

@using Microsoft.AspNetCore.Components.Authorization
@using StartFin.Dados
@using StartFin.Modelos
@using System.Security.Claims

@inject StartFinContext Context
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Quiz - Começando do zero | StartFin</PageTitle>

<div class="quiz-container">

    <a href="/educacao-financeira/comecando-do-zero" class="voltar">
        ← Voltar para a aula
    </a>

    <div class="cabecalho">
        <span class="etiqueta">STARTFIN • EDUCAÇÃO FINANCEIRA</span>
        <h1>Quiz: Começando do zero</h1>
        <p>
            Agora é hora de aplicar seus conhecimentos em situações reais.
            Leia com atenção antes de responder!
        </p>
        <span class="nivel">Nível intermediário • 10 questões</span>
    </div>

    @if (!Finalizado)
    {
        <div class="progresso">
            <div class="progresso-texto">
                <span>Pergunta @(Indice + 1) de @Perguntas.Count</span>
                <span>@Pontos pontos</span>
            </div>

            <div class="barra">
                <div class="barra-preenchida"
                     style="width: @(((Indice + 1) * 100.0 / Perguntas.Count).ToString(System.Globalization.CultureInfo.InvariantCulture))%">
                </div>
            </div>
        </div>

        <section class="pergunta-card">

            <span class="numero">QUESTÃO @(Indice + 1)</span>

            <h2>@Perguntas[Indice].Enunciado</h2>

            <div class="opcoes">
                @foreach (var opcao in Perguntas[Indice].Opcoes)
                {
                    <button class="opcao @(Selecionada == opcao ? "selecionada" : "")"
                            disabled="@Respondida"
                            @onclick="() => Selecionar(opcao)">
                        @opcao
                    </button>
                }
            </div>

            @if (Respondida)
            {
                <div class="feedback @(Acertou ? "correto" : "incorreto")">
                    <strong>
                        @(Acertou ? "Resposta correta!" : "Resposta incorreta!")
                    </strong>
                    <p>@Perguntas[Indice].Explicacao</p>
                </div>
            }

            <div class="acoes">
                @if (!Respondida)
                {
                    <button class="botao-principal"
                            disabled="@string.IsNullOrEmpty(Selecionada)"
                            @onclick="ConfirmarResposta">
                        Confirmar resposta
                    </button>
                }
                else
                {
                    <button class="botao-principal" @onclick="Proxima">
                        @(Indice == Perguntas.Count - 1
                            ? "Ver resultado"
                            : "Próxima pergunta")
                    </button>
                }
            </div>

        </section>
    }
    else
    {
        <section class="resultado-card">

            <span class="etiqueta">QUIZ CONCLUÍDO</span>
            <h2>Você terminou!</h2>

            <div class="pontuacao">
                @Pontos <small>/ @Perguntas.Count</small>
            </div>

            <p>Você acertou @Pontos de @Perguntas.Count perguntas.</p>

            <p class="mensagem">@MensagemResultado</p>

            @if (ResultadoSalvo)
            {
                <p class="salvo">
                    ✓ Seu resultado foi salvo na sua conta!
                </p>
            }
            else
            {
                <p class="aviso">@MensagemSalvamento</p>
            }

            <button class="botao-principal" @onclick="Reiniciar">
                Refazer quiz
            </button>

            <a href="/educacao-financeira/comecando-do-zero" class="link-aula">
                Voltar para a aula
            </a>

        </section>
    }

</div>

<style>
    .quiz-container {
        max-width: 850px;
        margin: 35px auto;
        padding: 20px;
        color: #172033;
    }

    .voltar, .link-aula {
        color: #087f5b;
        text-decoration: none;
        font-weight: 700;
    }

    .cabecalho {
        margin: 30px 0;
    }

    .etiqueta, .numero {
        color: #087f5b;
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 1px;
    }

    .cabecalho h1 {
        font-size: 32px;
        margin: 10px 0;
    }

    .cabecalho p {
        color: #64748b;
        line-height: 1.6;
    }

    .nivel {
        display: inline-block;
        margin-top: 10px;
        padding: 7px 12px;
        background: #ecfdf5;
        color: #087f5b;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 700;
    }

    .progresso {
        margin-bottom: 20px;
    }

    .progresso-texto {
        display: flex;
        justify-content: space-between;
        margin-bottom: 8px;
        font-weight: 700;
    }

    .barra {
        height: 9px;
        background: #e2e8f0;
        border-radius: 20px;
        overflow: hidden;
    }

    .barra-preenchida {
        height: 100%;
        background: #10b981;
        border-radius: 20px;
        transition: width .3s;
    }

    .pergunta-card, .resultado-card {
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 18px;
        padding: 30px;
        box-shadow: 0 5px 20px #00000008;
    }

    .pergunta-card h2 {
        font-size: 22px;
        line-height: 1.6;
        margin: 15px 0 25px;
    }

    .opcoes {
        display: grid;
        gap: 12px;
    }

    .opcao {
        width: 100%;
        text-align: left;
        padding: 16px;
        border: 1px solid #cbd5e1;
        border-radius: 12px;
        background: white;
        color: #172033;
        cursor: pointer;
        font-size: 15px;
        line-height: 1.5;
        transition: .2s;
    }

    .opcao:hover:not(:disabled) {
        border-color: #10b981;
        background: #f0fdf4;
    }

    .opcao.selecionada {
        border: 2px solid #059669;
        background: #ecfdf5;
    }

    .opcao:disabled {
        cursor: default;
        opacity: 1;
    }

    .feedback {
        margin-top: 20px;
        padding: 16px;
        border-radius: 12px;
        line-height: 1.6;
    }

    .feedback p {
        margin-bottom: 0;
    }

    .correto {
        background: #dcfce7;
        color: #166534;
    }

    .incorreto {
        background: #fee2e2;
        color: #991b1b;
    }

    .acoes {
        margin-top: 25px;
        display: flex;
        justify-content: flex-end;
    }

    .botao-principal {
        border: none;
        border-radius: 10px;
        padding: 14px 24px;
        background: #087f5b;
        color: white;
        font-weight: 700;
        cursor: pointer;
        font-size: 15px;
    }

    .botao-principal:hover {
        background: #066849;
    }

    .botao-principal:disabled {
        background: #94a3b8;
        cursor: not-allowed;
    }

    .resultado-card {
        text-align: center;
        padding: 45px 25px;
    }

    .resultado-card h2 {
        font-size: 28px;
    }

    .pontuacao {
        font-size: 65px;
        font-weight: 800;
        color: #087f5b;
        margin: 15px 0;
    }

    .pontuacao small {
        font-size: 25px;
        color: #64748b;
    }

    .mensagem {
        margin: 20px 0;
        color: #475569;
    }

    .salvo {
        color: #087f5b;
        font-weight: 700;
    }

    .aviso {
        color: #b45309;
    }

    .resultado-card .botao-principal {
        display: block;
        margin: 25px auto 15px;
    }

    @@media (max-width: 600px) {
        .cabecalho h1 {
            font-size: 26px;
        }

        .pergunta-card {
            padding: 20px;
        }

        .pergunta-card h2 {
            font-size: 19px;
        }
    }
</style>

@code {
    private int Indice = 0;
    private int Pontos = 0;

    private bool Respondida = false;
    private bool Acertou = false;
    private bool Finalizado = false;
    private bool ResultadoSalvo = false;

    private string Selecionada = string.Empty;
    private string MensagemResultado = string.Empty;
    private string MensagemSalvamento = string.Empty;

    private List<Pergunta> Perguntas = new()
    {
        new(
            "Lucas começou a receber mesada e percebeu que o dinheiro acabava antes do fim do mês. Qual deve ser sua primeira atitude?",
            new()
            {
                "Gastar o dinheiro conforme sentir vontade.",
                "Anotar quanto recebe e identificar onde está gastando.",
                "Deixar de acompanhar seus gastos.",
                "Pedir mais dinheiro sempre que acabar."
            },
            "Registrar os ganhos e os gastos ajuda Lucas a entender para onde o dinheiro está indo e a organizar melhor suas escolhas.",
            "Anotar quanto recebe e identificar onde está gastando."
        ),

        new(
            "Mariana quer comprar um celular novo, mas ainda não tem dinheiro suficiente. Qual atitude demonstra planejamento financeiro?",
            new()
            {
                "Comprar imediatamente usando qualquer empréstimo disponível.",
                "Desistir de organizar o próprio dinheiro.",
                "Definir uma meta e guardar dinheiro aos poucos.",
                "Gastar toda a mesada e esperar receber mais."
            },
            "Uma meta financeira ajuda a definir o que se deseja alcançar e permite economizar de forma planejada.",
            "Definir uma meta e guardar dinheiro aos poucos."
        ),

        new(
            "Pedro recebeu dinheiro de presente e está pensando em gastar tudo em jogos. O que ele deveria considerar antes de decidir?",
            new()
            {
                "Seus objetivos, suas necessidades e suas prioridades.",
                "Apenas o produto mais caro que consegue comprar.",
                "O que os amigos estão comprando.",
                "Como gastar todo o dinheiro rapidamente."
            },
            "Antes de gastar, é importante avaliar as prioridades e pensar se aquela compra combina com seus objetivos.",
            "Seus objetivos, suas necessidades e suas prioridades."
        ),

        new(
            "Ana deseja organizar suas finanças, mas não sabe por onde começar. Qual opção apresenta uma boa forma de iniciar?",
            new()
            {
                "Evitar pensar sobre dinheiro.",
                "Comprar primeiro e organizar depois.",
                "Controlar somente os gastos maiores.",
                "Registrar todos os ganhos e gastos, inclusive os pequenos."
            },
            "Até mesmo pequenas compras podem comprometer o orçamento. Registrar todas as despesas oferece uma visão mais completa.",
            "Registrar todos os ganhos e gastos, inclusive os pequenos."
        ),

        new(
            "Rafael quer comprar um tênis novo, mas também precisa guardar dinheiro para uma despesa importante. Como ele pode tomar uma decisão consciente?",
            new()
            {
                "Comprar o tênis sem considerar a outra despesa.",
                "Avaliar o que é prioridade e verificar se a compra cabe no orçamento.",
                "Usar todo o dinheiro disponível na compra.",
                "Ignorar a despesa importante."
            },
            "Uma decisão financeira consciente considera as necessidades, as prioridades e o dinheiro realmente disponível.",
            "Avaliar o que é prioridade e verificar se a compra cabe no orçamento."
        ),

        new(
            "Beatriz percebeu que costuma comprar coisas por impulso quando sai com os amigos. Qual atitude pode ajudá-la a mudar esse hábito?",
            new()
            {
                "Continuar comprando sem pensar.",
                "Evitar anotar as compras.",
                "Pensar antes de comprar e estabelecer limites para esses gastos.",
                "Gastar primeiro e verificar o saldo depois."
            },
            "Pensar antes de comprar e estabelecer limites ajuda a evitar decisões impulsivas e manter o controle financeiro.",
            "Pensar antes de comprar e estabelecer limites para esses gastos."
        ),

        new(
            "João está economizando para comprar um computador. Um amigo o convida para fazer uma compra que não estava planejada. Qual atitude é mais adequada?",
            new()
            {
                "Considerar se a compra é realmente necessária e se prejudica sua meta.",
                "Abandonar imediatamente seu objetivo.",
                "Gastar o dinheiro guardado sem avaliar as consequências.",
                "Comprar apenas porque o amigo também vai comprar."
            },
            "Antes de realizar uma compra, João deve avaliar se ela compromete o dinheiro reservado para seu objetivo.",
            "Considerar se a compra é realmente necessária e se prejudica sua meta."
        ),

        new(
            "Camila recebe dinheiro todos os meses, mas nunca consegue guardar uma parte. O que pode ajudá-la a melhorar essa situação?",
            new()
            {
                "Esperar que sobre dinheiro por acaso.",
                "Parar de acompanhar suas despesas.",
                "Aumentar os gastos sempre que receber.",
                "Planejar os gastos e separar uma quantia para economizar."
            },
            "Incluir a economia no planejamento mensal ajuda a criar o hábito de guardar dinheiro, em vez de depender apenas do que sobrar.",
            "Planejar os gastos e separar uma quantia para economizar."
        ),

        new(
            "Eduardo comprou um produto sem pesquisar preços e depois descobriu que poderia ter encontrado uma opção melhor. O que ele pode aprender com essa situação?",
            new()
            {
                "Pesquisar preços não faz diferença.",
                "Comparar opções antes da compra pode ajudar a economizar e escolher melhor.",
                "O primeiro produto encontrado é sempre a melhor escolha.",
                "O preço deve ser ignorado na hora de comprar."
            },
            "Pesquisar e comparar produtos permite avaliar preços, qualidade e condições antes de tomar uma decisão.",
            "Comparar opções antes da compra pode ajudar a economizar e escolher melhor."
        ),

        new(
            "Sofia quer ter uma vida financeira mais organizada. Qual conjunto de atitudes representa um bom começo?",
            new()
            {
                "Gastar sem planejamento e evitar guardar dinheiro.",
                "Comprar por impulso e ignorar as despesas.",
                "Registrar gastos, definir prioridades, estabelecer metas e economizar.",
                "Usar todo o dinheiro recebido antes de pensar no futuro."
            },
            "Organizar as finanças envolve acompanhar o dinheiro, definir prioridades, estabelecer objetivos e desenvolver o hábito de economizar.",
            "Registrar gastos, definir prioridades, estabelecer metas e economizar."
        )
    };

    private void Selecionar(string opcao)
    {
        if (!Respondida)
        {
            Selecionada = opcao;
        }
    }

    private void ConfirmarResposta()
    {
        if (string.IsNullOrEmpty(Selecionada) || Respondida)
            return;

        Acertou = Selecionada == Perguntas[Indice].RespostaCorreta;

        if (Acertou)
            Pontos++;

        Respondida = true;
    }

    private async Task Proxima()
    {
        if (Indice < Perguntas.Count - 1)
        {
            Indice++;
            Selecionada = string.Empty;
            Respondida = false;
            Acertou = false;
        }
        else
        {
            Finalizado = true;

            MensagemResultado = Pontos switch
            {
                10 => "Excelente! Você demonstrou domínio dos conceitos e das situações financeiras apresentadas.",
                >= 8 => "Muito bom! Você conseguiu aplicar a maioria dos conceitos financeiros corretamente.",
                >= 6 => "Bom esforço! Você já compreende vários conceitos, mas ainda pode melhorar.",
                _ => "Continue praticando! Revise a aula e tente novamente para fortalecer seus conhecimentos."
            };

            await SalvarResultadoAsync();
        }
    }

    private async Task SalvarResultadoAsync()
    {
        try
        {
            var estado = await AuthenticationStateProvider.GetAuthenticationStateAsync();

            var usuarioId = estado.User.FindFirst(
                ClaimTypes.NameIdentifier)?.Value;

            if (string.IsNullOrEmpty(usuarioId))
            {
                MensagemSalvamento = "Entre na sua conta para salvar seu resultado.";
                return;
            }

            var resultado = new ResultadoQuiz
            {
                UsuarioId = usuarioId,
                IdentificadorQuiz = "comecando-do-zero",
                Pontos = Pontos,
                TotalPerguntas = Perguntas.Count,
                DataConclusao = DateTime.UtcNow
            };

            Context.ResultadosQuiz.Add(resultado);
            await Context.SaveChangesAsync();

            ResultadoSalvo = true;
        }
        catch
        {
            MensagemSalvamento = "Não foi possível salvar o resultado. Tente novamente mais tarde.";
        }
    }

    private void Reiniciar()
    {
        Indice = 0;
        Pontos = 0;
        Respondida = false;
        Acertou = false;
        Finalizado = false;
        ResultadoSalvo = false;

        Selecionada = string.Empty;
        MensagemResultado = string.Empty;
        MensagemSalvamento = string.Empty;
    }

    private class Pergunta
    {
        public string Enunciado { get; set; }
        public List<string> Opcoes { get; set; }
        public string Explicacao { get; set; }
        public string RespostaCorreta { get; set; }

        public Pergunta(
            string enunciado,
            List<string> opcoes,
            string explicacao,
            string respostaCorreta)
        {
            Enunciado = enunciado;
            Opcoes = opcoes;
            Explicacao = explicacao;
            RespostaCorreta = respostaCorreta;
        }
    }
}
