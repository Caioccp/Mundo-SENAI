@page "/movimentacoes"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using System.Globalization
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using StartFin.Modelos
@using StartFin.Servicos

@inject CarteiraServico CarteiraServico
@inject AuthenticationStateProvider AuthProvider

<PageTitle>Histórico | StartFin</PageTitle>

<div class="pagina">

    <header class="topo">
        <div>
            <span class="etiqueta">MINHA CARTEIRA</span>
            <h1>Histórico de movimentações 📋</h1>
            <p>Acompanhe todas as entradas e saídas da sua carteira.</p>
        </div>

        <a href="/" class="botao-voltar">← Voltar ao Menu</a>
    </header>

    @if (Carregando)
    {
        <div class="cartao">
            <p>Carregando seu histórico...</p>
        </div>
    }
    else
    {
        <section class="saldo">
            <span>Saldo atual</span>
            <h2>@Saldo.ToString("C2", Cultura)</h2>
            <p>Seu saldo é atualizado automaticamente.</p>
        </section>

        <section class="cartao">
            <h2>Suas movimentações</h2>
            <p>Confira todas as entradas e saídas registradas.</p>

            @if (ListaMovimentacoes.Count == 0)
            {
                <div class="vazio">
                    <span>📋</span>
                    <p>Nenhuma movimentação registrada ainda.</p>
                </div>
            }
            else
            {
                <div class="historico">
                    @foreach (var item in ListaMovimentacoes)
                    {
                        <div class="movimentacao">
                            <div>
                                <strong>@item.Descricao</strong>
                                <p>@item.Data.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p>
                            </div>

                            <div class="valor @(item.Tipo == "Entrada" ? "entrada" : "saida")">
                                <span>@item.Tipo</span>
                                <strong>
                                    @(item.Tipo == "Entrada" ? "+" : "-")
                                    @item.Valor.ToString("C2", Cultura)
                                </strong>
                            </div>
                        </div>
                    }
                </div>
            }
        </section>

        <a href="/nova-movimentacao" class="botao-nova">
            + Fazer movimentação
        </a>
    }
</div>

<style>
    .pagina {
        padding: 30px;
        color: #26364a;
    }

    .topo {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 20px;
        margin-bottom: 30px;
    }

    .etiqueta {
        color: #16a085;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 1px;
    }

    .topo h1 {
        margin: 8px 0;
        color: #172b4d;
        font-size: 34px;
        font-weight: 800;
    }

    .topo p, .cartao p {
        color: #718096;
    }

    .botao-voltar {
        background: #edf2f7;
        color: #2455a4;
        padding: 10px 16px;
        border-radius: 10px;
        text-decoration: none;
        font-weight: 700;
    }

    .saldo {
        background: #087f5b;
        color: white;
        padding: 28px;
        border-radius: 16px;
        margin-bottom: 22px;
    }

    .saldo span {
        font-size: 14px;
    }

    .saldo h2 {
        font-size: 36px;
        margin: 10px 0;
    }

    .saldo p {
        margin: 0;
        opacity: 0.85;
    }

    .cartao {
        background: white;
        padding: 26px;
        border-radius: 16px;
        box-shadow: 0 4px 18px rgba(0,0,0,0.04);
        margin-bottom: 22px;
    }

    .cartao h2 {
        color: #172b4d;
        margin-top: 0;
    }

    .vazio {
        padding: 25px;
        text-align: center;
        background: #f4f7fb;
        border-radius: 12px;
    }

    .vazio span {
        font-size: 30px;
    }

    .movimentacao {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        padding: 18px 0;
        border-bottom: 1px solid #edf2f7;
    }

    .movimentacao p {
        font-size: 13px;
        margin-bottom: 0;
    }

    .valor {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 5px;
    }

    .entrada {
        color: #087f5b;
    }

    .saida {
        color: #d64545;
    }

    .botao-nova {
        display: inline-block;
        padding: 13px 20px;
        border-radius: 10px;
        background: #087f5b;
        color: white;
        font-weight: 700;
        text-decoration: none;
    }

    .botao-nova:hover {
        background: #066849;
    }

    @@media (max-width: 650px) {
        .pagina {
            padding: 18px;
        }

        .topo {
            flex-direction: column;
        }

        .movimentacao {
            align-items: flex-start;
        }
    }
</style>

@code {
    private static readonly CultureInfo Cultura =
        CultureInfo.GetCultureInfo("pt-BR");

    private string UsuarioId = string.Empty;
    private decimal Saldo;
    private bool Carregando = true;

    private List<Movimentacao> ListaMovimentacoes = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var estado = await AuthProvider.GetAuthenticationStateAsync();

            UsuarioId = estado.User.FindFirst(
                ClaimTypes.NameIdentifier)?.Value ?? string.Empty;

            if (string.IsNullOrEmpty(UsuarioId))
                return;

            var carteira = await CarteiraServico
                .ObterOuCriarCarteiraAsync(UsuarioId);

            Saldo = carteira.SaldoDisponivel;

            ListaMovimentacoes =
                await CarteiraServico.ListarMovimentacoesAsync(UsuarioId);
        }
        finally
        {
            Carregando = false;
        }
    }
}