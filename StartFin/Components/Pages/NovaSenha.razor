
@page "/nova-senha"

<PageTitle>Nova senha | StartFin</PageTitle>

<div class="container mt-5" style="max-width: 480px;">
    <h1>Criar nova senha</h1>
    <p>Escolha uma nova senha para acessar sua conta.</p>

    @if (Erro == "1")
    {
        <div class="alert alert-danger">
            Não foi possível redefinir a senha. Confira os dados e tente novamente.
        </div>
    }

    <form method="post" action="/finalizar-recuperacao">
        <AntiforgeryToken />

        <div class="mb-3">
            <label class="form-label">Nova senha</label>

            <div class="input-group">
                <input id="novaSenha"
                       class="form-control"
                       type="password"
                       name="novaSenha"
                       minlength="8"
                       autocomplete="new-password"
                       required />

                <button class="btn btn-outline-secondary"
                        type="button"
                        onclick="alternarVisibilidade('novaSenha', this)"
                        aria-label="Mostrar senha"
                        title="Mostrar senha">
                    <svg xmlns="http://www.w3.org/2000/svg"
                         width="20" height="20"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         stroke-linecap="round"
                         stroke-linejoin="round">
                        <path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7z" />
                        <circle cx="12" cy="12" r="3" />
                    </svg>
                </button>
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label">Confirmar nova senha</label>

            <div class="input-group">
                <input id="confirmarSenha"
                       class="form-control"
                       type="password"
                       name="confirmarSenha"
                       minlength="8"
                       autocomplete="new-password"
                       required />

                <button class="btn btn-outline-secondary"
                        type="button"
                        onclick="alternarVisibilidade('confirmarSenha', this)"
                        aria-label="Mostrar confirmação da senha"
                        title="Mostrar confirmação da senha">
                    <svg xmlns="http://www.w3.org/2000/svg"
                         width="20" height="20"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         stroke-linecap="round"
                         stroke-linejoin="round">
                        <path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7z" />
                        <circle cx="12" cy="12" r="3" />
                    </svg>
                </button>
            </div>
        </div>

        <button type="submit" class="btn btn-primary w-100">
            Redefinir senha
        </button>
    </form>

    <p class="mt-3 text-center">
        <a href="/entrar">Voltar para entrar</a>
    </p>
</div>

<script>
    function alternarVisibilidade(id, botao) {
        const campo = document.getElementById(id);

        if (!campo) return;

        const mostrar = campo.type === "password";

        campo.type = mostrar ? "text" : "password";

        botao.setAttribute(
            "aria-label",
            mostrar ? "Ocultar senha" : "Mostrar senha"
        );

        botao.setAttribute(
            "title",
            mostrar ? "Ocultar senha" : "Mostrar senha"
        );

        if (mostrar) {
            botao.innerHTML = `
                <svg xmlns="http://www.w3.org/2000/svg"
                     width="20" height="20"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     stroke-linecap="round"
                     stroke-linejoin="round">
                    <path d="M3 3l18 18" />
                    <path d="M10.6 10.6a2 2 0 0 0 2.8 2.8" />
                    <path d="M9.9 5.2A10.8 10.8 0 0 1 12 5c5 0 9 7 9 7a15.5 15.5 0 0 1-3 3.8" />
                    <path d="M6.6 6.6C4.1 8.2 3 12 3 12s4 7 9 7a10 10 0 0 0 4-.8" />
                </svg>`;
        } else {
            botao.innerHTML = `
                <svg xmlns="http://www.w3.org/2000/svg"
                     width="20" height="20"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2"
                     stroke-linecap="round"
                     stroke-linejoin="round">
                    <path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7z" />
                    <circle cx="12" cy="12" r="3" />
                </svg>`;
        }
    }
</script>

@code {
    [SupplyParameterFromQuery(Name = "erro")]
    public string? Erro { get; set; }
}
