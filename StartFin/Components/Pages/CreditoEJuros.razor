    }

    .aula-cabecalho h1 {
        font-size: 36px;
        margin: 12px 0;
    }

    .aula-cabecalho p,
    .conteudo-aula p,
    .resumo-aula p,
    .quiz-chamada p {
        line-height: 1.7;
    }

    .conteudo-aula,
    .resumo-aula {
        margin-bottom: 25px;
        padding: 25px;
        border-radius: 14px;
