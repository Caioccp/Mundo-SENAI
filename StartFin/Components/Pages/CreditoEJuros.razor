    .resumo-aula h2 {
        color: #16865b;
        margin-top: 0;
    }

    .conteudo-aula h3 {
        margin-top: 22px;
    }

    .conteudo-aula li {
        margin-bottom: 10px;
        line-height: 1.5;
    }

    .destaque-aula,
    .exemplo-aula {
