@page "/recuperar-senha"

<PageTitle>Recuperar senha | StartFin</PageTitle>

<div class="container mt-5" style="max-width: 480px;">
    <h1>Recuperar senha</h1>
    <p>Preencha os dados da sua conta para iniciar a recuperação.</p>

    @if (Erro == "1")
    {
        <div class="alert alert-danger" role="alert">
            Não foi possível validar os dados. Confira as informações e tente novamente.
        </div>
    }

    <div class="alert alert-info">
        <strong>Contas de maiores de 18 anos:</strong>
        informe seu próprio código secreto de recuperação.

        <br /><br />

        <strong>Contas de menores de 18 anos:</strong>
        informe o código familiar fornecido pelo responsável adulto vinculado à sua conta.
    </div>

    <form method="post" action="/iniciar-recuperacao">
        <AntiforgeryToken />

        <div class="mb-3">
            <label class="form-label">Nome de usuário</label>
            <input class="form-control" type="text" name="usuario" maxlength="30" required />
        </div>

        <div class="mb-3">
            <label class="form-label">Nome completo</label>
            <input class="form-control" type="text" name="nomeCompleto" maxlength="150" required />
        </div>

        <div class="mb-3">
            <label class="form-label">Data de nascimento</label>
            <input class="form-control" type="date" name="dataNascimento" required />
        </div>

        <div class="mb-3">
            <label class="form-label">Código de recuperação</label>
            <input class="form-control" type="text" name="codigoRecuperacao" placeholder="SF-..." required />
        </div>

        <button type="submit" class="btn btn-primary w-100">
            Verificar dados
        </button>
    </form>

    <p class="mt-3 text-center">
        <a href="/entrar">Voltar para entrar</a>
    </p>
</div>

@code {
    [SupplyParameterFromQuery(Name = "erro")]
    public string? Erro { get; set; }
}