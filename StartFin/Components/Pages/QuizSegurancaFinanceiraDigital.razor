    }

    .opcao:hover:not(:disabled) {
        border-color: #10b981;
        background: #f0fdf4;
    }

    .opcao.selecionada {
        border: 2px solid #059669;
        background: #ecfdf5;
    }

    .opcao:disabled {
        cursor: default;
        opacity: 1;
    }

    .feedback {
        margin-top: 20px;
        padding: 16px;
        border-radius: 12px;
        line-height: 1.6;
    }

    .feedback p {
        margin-bottom: 0;
    }

    .correto {
        background: #dcfce7;
        color: #166534;
    }

    .incorreto {
        background: #fee2e2;
        color: #991b1b;
    }

    .acoes {
        margin-top: 25px;
        display: flex;
        justify-content: flex-end;
    }

    .botao-principal {
        border: none;
        border-radius: 10px;
        padding: 14px 24px;
        background: #087f5b;
