
@page "/educacao-financeira/quiz/organize-seu-dinheiro"

@using Microsoft.AspNetCore.Components.Authorization
@using StartFin.Dados
@using StartFin.Modelos
@using System.Security.Claims

@inject StartFinContext Context
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Quiz - Organize seu dinheiro | StartFin</PageTitle>

<div class="quiz-container">

    <a href="/educacao-financeira/organize-seu-dinheiro" class="voltar">
        ← Voltar para a aula
    </a>

    <div class="cabecalho">
        <span class="etiqueta">STARTFIN • EDUCAÇÃO FINANCEIRA</span>
        <h1>Quiz: Organize seu dinheiro</h1>
        <p>
            Teste sua capacidade de organizar ganhos, controlar despesas
            e tomar decisões financeiras conscientes.
        </p>
        <span class="nivel">Nível intermediário • 10 questões</span>
    </div>

    @if (!Finalizado)
    {
        <div class="progresso">
            <div class="progresso-texto">
                <span>Pergunta @(Indice + 1) de @Perguntas.Count</span>
                <span>@Pontos pontos</span>
            </div>

            <div class="barra">
                <div class="barra-preenchida"
                     style="width: @(((Indice + 1) * 100.0 / Perguntas.Count).ToString(System.Globalization.CultureInfo.InvariantCulture))%">
                </div>
            </div>
        </div>

        <section class="pergunta-card">

            <span class="numero">QUESTÃO @(Indice + 1)</span>

            <h2>@Perguntas[Indice].Enunciado</h2>

            <div class="opcoes">
                @foreach (var opcao in Perguntas[Indice].Opcoes)
                {
                    <button class="opcao @(Selecionada == opcao ? "selecionada" : "")"
                            disabled="@Respondida"
                            @onclick="() => Selecionar(opcao)">
                        @opcao
                    </button>
                }
            </div>

            @if (Respondida)
            {
                <div class="feedback @(Acertou ? "correto" : "incorreto")">
                    <strong>
                        @(Acertou ? "Resposta correta!" : "Resposta incorreta!")
                    </strong>
                    <p>@Perguntas[Indice].Explicacao</p>
                </div>
            }

            <div class="acoes">
                @if (!Respondida)
                {
                    <button class="botao-principal"
                            disabled="@string.IsNullOrEmpty(Selecionada)"
                            @onclick="ConfirmarResposta">
                        Confirmar resposta
                    </button>
                }
                else
                {
                    <button class="botao-principal" @onclick="Proxima">
                        @(Indice == Perguntas.Count - 1
                            ? "Ver resultado"
                            : "Próxima pergunta")
                    </button>
                }
            </div>

        </section>
    }
    else
    {
        <section class="resultado-card">

            <span class="etiqueta">QUIZ CONCLUÍDO</span>
            <h2>Você terminou!</h2>

            <div class="pontuacao">
                @Pontos <small>/ @Perguntas.Count</small>
            </div>

            <p>Você acertou @Pontos de @Perguntas.Count perguntas.</p>

            <p class="mensagem">@MensagemResultado</p>

            @if (ResultadoSalvo)
            {
                <p class="salvo">
                    ✓ Seu resultado foi salvo na sua conta!
                </p>
            }
            else
            {
                <p class="aviso">@MensagemSalvamento</p>
            }

            <button class="botao-principal" @onclick="Reiniciar">
                Refazer quiz
            </button>

            <a href="/educacao-financeira/organize-seu-dinheiro" class="link-aula">
                Voltar para a aula
            </a>

        </section>
    }

</div>

<style>
    .quiz-container {
        max-width: 850px;
        margin: 35px auto;
        padding: 20px;
        color: #172033;
    }

    .voltar, .link-aula {
        color: #087f5b;
        text-decoration: none;
        font-weight: 700;
    }

    .cabecalho {
        margin: 30px 0;
    }

    .etiqueta, .numero {
        color: #087f5b;
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 1px;
    }

    .cabecalho h1 {
        font-size: 32px;
        margin: 10px 0;
    }

    .cabecalho p {
        color: #64748b;
        line-height: 1.6;
    }

    .nivel {
        display: inline-block;
        margin-top: 10px;
        padding: 7px 12px;
        background: #ecfdf5;
        color: #087f5b;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 700;
    }

    .progresso {
        margin-bottom: 20px;
    }

    .progresso-texto {
        display: flex;
        justify-content: space-between;
        margin-bottom: 8px;
        font-weight: 700;
    }

    .barra {
        height: 9px;
        background: #e2e8f0;
        border-radius: 20px;
        overflow: hidden;
    }

    .barra-preenchida {
        height: 100%;
        background: #10b981;
        border-radius: 20px;
        transition: width .3s;
    }

    .pergunta-card, .resultado-card {
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 18px;
        padding: 30px;
        box-shadow: 0 5px 20px #00000008;
    }

    .pergunta-card h2 {
        font-size: 22px;
        line-height: 1.6;
        margin: 15px 0 25px;
    }

    .opcoes {
        display: grid;
        gap: 12px;
    }

    .opcao {
        width: 100%;
        text-align: left;
        padding: 16px;
        border: 1px solid #cbd5e1;
        border-radius: 12px;
        background: white;
        color: #172033;
        cursor: pointer;
        font-size: 15px;
        line-height: 1.5;
        transition: .2s;
    }

    .opcao:hover:not(:disabled) {
        border-color: #10b981;
        background: #f0fdf4;
    }

    .opcao.selecionada {
        border: 2px solid #059669;
        background: #ecfdf5;
    }

    .opcao:disabled {
        cursor: default;
        opacity: 1;
    }

    .feedback {
        margin-top: 20px;
        padding: 16px;
        border-radius: 12px;
        line-height: 1.6;
    }

    .feedback p {
        margin-bottom: 0;
    }

    .correto {
        background: #dcfce7;
        color: #166534;
    }

    .incorreto {
        background: #fee2e2;
        color: #991b1b;
    }

    .acoes {
        margin-top: 25px;
        display: flex;
        justify-content: flex-end;
    }

    .botao-principal {
        border: none;
        border-radius: 10px;
        padding: 14px 24px;
        background: #087f5b;
        color: white;
        font-weight: 700;
        cursor: pointer;
        font-size: 15px;
    }

    .botao-principal:hover {
        background: #066849;
    }

    .botao-principal:disabled {
        background: #94a3b8;
        cursor: not-allowed;
    }

    .resultado-card {
        text-align: center;
        padding: 45px 25px;
    }

    .resultado-card h2 {
        font-size: 28px;
    }

    .pontuacao {
        font-size: 65px;
        font-weight: 800;
        color: #087f5b;
        margin: 15px 0;
    }

    .pontuacao small {
        font-size: 25px;
        color: #64748b;
    }

    .mensagem {
        margin: 20px 0;
        color: #475569;
    }

    .salvo {
        color: #087f5b;
        font-weight: 700;
    }

    .aviso {
        color: #b45309;
    }

    .resultado-card .botao-principal {
        display: block;
        margin: 25px auto 15px;
    }

    @@media (max-width: 600px) {
        .cabecalho h1 {
            font-size: 26px;
        }

        .pergunta-card {
            padding: 20px;
        }

        .pergunta-card h2 {
            font-size: 19px;
        }
    }
</style>

@code {
    private int Indice = 0;
    private int Pontos = 0;

    private bool Respondida = false;
    private bool Acertou = false;
    private bool Finalizado = false;
    private bool ResultadoSalvo = false;

    private string Selecionada = string.Empty;
    private string MensagemResultado = string.Empty;
    private string MensagemSalvamento = string.Empty;

    private List<Pergunta> Perguntas = new()
{
    new(
        "Marcos recebe R$ 900,00 por mês. Suas despesas são: R$ 300,00 com transporte, R$ 250,00 com alimentação e R$ 180,00 com outras necessidades. Quanto sobra antes de considerar novos gastos?",
        new()
        {
            "R$ 170,00.",
            "R$ 180,00.",
            "R$ 190,00.",
            "R$ 200,00."
        },
        "Somando as despesas, temos R$ 730,00. Subtraindo esse valor dos R$ 900,00 recebidos, sobram R$ 170,00.",
        "R$ 170,00."
    ),

    new(
        "Uma estudante recebe uma mesada de R$ 400,00. Ela paga R$ 100,00 de transporte, R$ 80,00 de alimentação e R$ 50,00 de uma assinatura mensal. Qual análise está correta?",
        new()
        {
            "Todas as despesas são variáveis, pois podem ser canceladas.",
            "Apenas a alimentação deve entrar no planejamento financeiro.",
            "As despesas precisam ser registradas, e a assinatura representa um compromisso recorrente.",
            "O valor restante deve ser considerado automaticamente como dinheiro disponível para gastar."
        },
        "Todas as despesas devem ser consideradas no orçamento. A assinatura é um compromisso recorrente, e o dinheiro restante ainda precisa ser organizado conforme as prioridades.",
        "As despesas precisam ser registradas, e a assinatura representa um compromisso recorrente."
    ),

    new(
        "Fernanda planejou gastar R$ 250,00 durante o mês com lazer, mas já utilizou R$ 190,00 e ainda tem dois passeios planejados. Qual decisão demonstra melhor controle financeiro?",
        new()
        {
            "Manter os dois passeios mesmo que ultrapassem o limite.",
            "Verificar quanto cada passeio custará e ajustar os planos para respeitar o limite restante.",
            "Ignorar os gastos anteriores e considerar apenas os próximos passeios.",
            "Utilizar dinheiro reservado para despesas essenciais."
        },
        "Restam R$ 60,00 do orçamento de lazer. Fernanda deve avaliar os custos dos passeios e decidir se consegue realizar ambos sem ultrapassar esse limite.",
        "Verificar quanto cada passeio custará e ajustar os planos para respeitar o limite restante."
    ),

    new(
        "Rafael recebe R$ 1.200,00. Seus gastos mensais somam R$ 950,00, mas ele deseja guardar R$ 300,00 todos os meses. Qual é o problema desse planejamento?",
        new()
        {
            "O planejamento está correto, pois guardar dinheiro não depende das despesas.",
            "Ele precisa aumentar seus gastos para equilibrar o orçamento.",
            "O valor economizado deve ser retirado das despesas essenciais.",
            "A economia planejada ultrapassa em R$ 50,00 o valor disponível."
        },
        "Depois das despesas, Rafael tem R$ 250,00 disponíveis. Portanto, guardar R$ 300,00 exigiria R$ 50,00 a mais do que seu orçamento permite.",
        "A economia planejada ultrapassa em R$ 50,00 o valor disponível."
    ),

    new(
        "Beatriz percebeu que seu orçamento apresenta despesas que acontecem todos os meses e outras que mudam de acordo com seu consumo. Qual alternativa apresenta apenas exemplos de despesas variáveis?",
        new()
        {
            "Compras de roupas e passeios.",
            "Mensalidade de curso e aluguel.",
            "Plano mensal de celular e assinatura.",
            "Parcela fixa de um financiamento e aluguel."
        },
        "Compras de roupas e passeios podem variar em frequência e valor. As outras alternativas apresentam compromissos geralmente recorrentes e previsíveis.",
        "Compras de roupas e passeios."
    ),

    new(
        "João costuma gastar R$ 12,00 por dia com lanches durante 20 dias do mês. Se decidir levar lanche de casa em metade desses dias, quanto poderá economizar?",
        new()
        {
            "R$ 100,00.",
            "R$ 110,00.",
            "R$ 120,00.",
            "R$ 140,00."
        },
        "Metade de 20 dias corresponde a 10 dias. Economizando R$ 12,00 em cada um deles, João poderá guardar R$ 120,00.",
        "R$ 120,00."
    ),

    new(
        "Camila registrou os seguintes resultados: em janeiro gastou R$ 500,00; em fevereiro, R$ 560,00; e em março, R$ 650,00. O que esses registros indicam?",
        new()
        {
            "Que suas despesas diminuíram ao longo dos meses.",
            "Que seu orçamento permaneceu estável.",
            "Que os gastos aumentaram, mas não é necessário investigar o motivo.",
            "Que existe uma tendência de aumento das despesas que merece ser analisada."
        },
        "Os gastos aumentaram R$ 60,00 de janeiro para fevereiro e R$ 90,00 de fevereiro para março. Comparar os registros ajuda a identificar essa mudança e investigar suas causas.",
        "Que existe uma tendência de aumento das despesas que merece ser analisada."
    ),

    new(
        "Pedro recebe R$ 700,00 e precisa pagar R$ 280,00 de despesas essenciais. Ele também planeja guardar R$ 150,00 e gastar R$ 180,00 com lazer. Quanto restará após esses compromissos?",
        new()
        {
            "R$ 80,00.",
            "R$ 90,00.",
            "R$ 100,00.",
            "R$ 110,00."
        },
        "Somando as despesas essenciais, a economia e o lazer, temos R$ 610,00. Subtraindo de R$ 700,00, restam R$ 90,00.",
        "R$ 90,00."
    ),

    new(
        "Uma pessoa percebe que está gastando mais do que recebe durante vários meses. Qual medida deve ser tomada para recuperar o equilíbrio financeiro?",
        new()
        {
            "Identificar os gastos que podem ser reduzidos e reorganizar o orçamento.",
            "Continuar mantendo os mesmos gastos e esperar que a situação melhore.",
            "Deixar de registrar as despesas para evitar perceber o problema.",
            "Aumentar as compras parceladas para distribuir os pagamentos."
        },
        "Quando as despesas superam os ganhos, é necessário analisar o orçamento, identificar possibilidades de redução e ajustar os gastos à renda disponível.",
        "Identificar os gastos que podem ser reduzidos e reorganizar o orçamento."
    ),

    new(
        "Sofia possui R$ 500,00 disponíveis. Ela precisa reservar R$ 200,00 para despesas importantes, pretende guardar R$ 100,00 e deseja comprar um item de R$ 250,00. Qual seria a decisão financeiramente mais adequada?",
        new()
        {
            "Comprar o item e utilizar parte do dinheiro reservado para despesas.",
            "Comprar o item porque ainda possui dinheiro disponível na conta.",
            "Reavaliar a compra, pois os compromissos e a economia planejada deixam apenas R$ 200,00 disponíveis.",
            "Abandonar o planejamento e decidir apenas no momento da compra."
        },
        "Após reservar R$ 200,00 para despesas e R$ 100,00 para economias, Sofia terá R$ 200,00 disponíveis. Como o item custa R$ 250,00, precisará adiar a compra ou rever o planejamento.",
        "Reavaliar a compra, pois os compromissos e a economia planejada deixam apenas R$ 200,00 disponíveis."
    )
};

    private void Selecionar(string opcao)
    {
        if (!Respondida)
        {
            Selecionada = opcao;
        }
    }

    private void ConfirmarResposta()
    {
        if (string.IsNullOrEmpty(Selecionada) || Respondida)
            return;

        Acertou = Selecionada == Perguntas[Indice].RespostaCorreta;

        if (Acertou)
            Pontos++;

        Respondida = true;
    }

    private async Task Proxima()
    {
        if (Indice < Perguntas.Count - 1)
        {
            Indice++;
            Selecionada = string.Empty;
            Respondida = false;
            Acertou = false;
        }
        else
        {
            Finalizado = true;

            MensagemResultado = Pontos switch
            {
                10 => "Excelente! Você demonstrou domínio da organização financeira e sabe tomar decisões conscientes.",
                >= 8 => "Muito bom! Você entende como planejar seus gastos e organizar suas prioridades.",
                >= 6 => "Bom esforço! Você já conhece vários conceitos, mas ainda pode melhorar sua organização.",
                _ => "Continue praticando! Revise a aula e tente novamente para fortalecer seus conhecimentos."
            };

            await SalvarResultadoAsync();
        }
    }

    private async Task SalvarResultadoAsync()
    {
        try
        {
            var estado = await AuthenticationStateProvider.GetAuthenticationStateAsync();

            var usuarioId = estado.User.FindFirst(
                ClaimTypes.NameIdentifier)?.Value;

            if (string.IsNullOrEmpty(usuarioId))
            {
                MensagemSalvamento = "Entre na sua conta para salvar seu resultado.";
                return;
            }

            var resultado = new ResultadoQuiz
            {
                UsuarioId = usuarioId,
                IdentificadorQuiz = "organize-seu-dinheiro",
                Pontos = Pontos,
                TotalPerguntas = Perguntas.Count,
                DataConclusao = DateTime.UtcNow
            };

            Context.ResultadosQuiz.Add(resultado);
            await Context.SaveChangesAsync();

            ResultadoSalvo = true;
        }
        catch
        {
            MensagemSalvamento = "Não foi possível salvar o resultado. Tente novamente mais tarde.";
        }
    }

    private void Reiniciar()
    {
        Indice = 0;
        Pontos = 0;
        Respondida = false;
        Acertou = false;
        Finalizado = false;
        ResultadoSalvo = false;

        Selecionada = string.Empty;
        MensagemResultado = string.Empty;
        MensagemSalvamento = string.Empty;
    }

    private class Pergunta
    {
        public string Enunciado { get; set; }
        public List<string> Opcoes { get; set; }
        public string Explicacao { get; set; }
        public string RespostaCorreta { get; set; }

        public Pergunta(
            string enunciado,
            List<string> opcoes,
            string explicacao,
            string respostaCorreta)
        {
            Enunciado = enunciado;
            Opcoes = opcoes;
            Explicacao = explicacao;
            RespostaCorreta = respostaCorreta;
        }
    }
}
