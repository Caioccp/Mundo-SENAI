
@page "/desafios"

@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@using StartFin.Dados
@using StartFin.Modelos
@using StartFin.Servicos

@inject AuthenticationStateProvider AuthStateProvider
@inject StartFinContext Context
@inject DesafioServico DesafioServico
@inject ConquistaServico ConquistaServico

<PageTitle>Desafios | StartFin</PageTitle>

<div class="container mt-4">

       <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">

        <h1>🏆 Desafios</h1>

        <a href="/" class="btn btn-primary">
            ← Voltar ao Menu
        </a>

    </div>

    <p>
        Complete pequenas tarefas e ganhe pontos enquanto aprende
        a cuidar do seu dinheiro!
    </p>
    @if (!string.IsNullOrWhiteSpace(mensagem))
    {
        <div class="alert alert-info">@mensagem</div>
    }

    <div class="card p-3 mb-4">
        <h2>⭐ Minha pontuação</h2>
        <h3>@pontuacao pontos</h3>
        <small>Todos os pontos conquistados até hoje.</small>
    </div>

    
<div class="card p-3 mb-4">

    <div class="d-flex justify-content-between align-items-center flex-wrap">

        <div>
            <h2>🏅 Meu nível</h2>
            <h3>Nível @nivel - @nomeNivel</h3>
        </div>

        <span class="badge bg-success fs-6">
            @pontuacao XP
        </span>

    </div>

    @if (pontuacao >= 500)
    {
        <p class="text-success fw-bold mt-3">
            🎉 Você alcançou o nível máximo!
        </p>
    }
    else
    {
        <div class="progress mt-3 mb-2" style="height: 15px;">

            <div class="progress-bar bg-success"
                 role="progressbar"
                 style="width: @(progressoNivel)%"
                 aria-valuenow="@progressoNivel"
                 aria-valuemin="0"
                 aria-valuemax="100">
            </div>

        </div>

        <div class="d-flex justify-content-between flex-wrap">

            <small>
                @xpDentroNivel / @xpNecessarioNivel XP neste nível
            </small>

            <small>
                Faltam @xpFaltando XP para evoluir
            </small>

        </div>
    }

</div>


    @if (carregando)
    {
        <p>Carregando desafios...</p>
    }
    else if (!string.IsNullOrWhiteSpace(usuarioId))
    {
        <div class="d-flex gap-2 mb-4 flex-wrap">

            <button class="btn @(categoriaSelecionada == "Diário" ? "btn-success" : "btn-outline-success")"
                    @onclick='() => SelecionarCategoria("Diário")'>
                🌞 Desafios diários
            </button>

            <button class="btn @(categoriaSelecionada == "Semanal" ? "btn-success" : "btn-outline-success")"
                    @onclick='() => SelecionarCategoria("Semanal")'>
                📅 Desafios semanais
            </button>

            <button class="btn @(categoriaSelecionada == "Mensal" ? "btn-success" : "btn-outline-success")"
                    @onclick='() => SelecionarCategoria("Mensal")'>
                🗓️ Desafios mensais
            </button>

        </div>

        @if (categoriaSelecionada == "Diário")
        {
            <h2>🌞 Desafios diários</h2>
        }
        else if (categoriaSelecionada == "Semanal")
        {
            <h2>📅 Desafios semanais</h2>
        }
        else
        {
            <h2>🗓️ Desafios mensais</h2>
        }

        @if (!desafios.Any(d => d.Tipo == categoriaSelecionada))
        {
            <div class="card p-3">
                <p>Nenhum desafio disponível nesta categoria.</p>
            </div>
        }
        else
        {
            @foreach (var desafio in desafios.Where(d => d.Tipo == categoriaSelecionada))
            {
                var percentual = desafio.MetaProgresso > 0
                    ? Math.Min(100, (double)(desafio.ProgressoAtual / desafio.MetaProgresso * 100))
                    : 0;

                <div class="card p-3 mb-3" @key="desafio.Id">

                    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">

                        <h3>@desafio.Titulo</h3>

                        <span class="badge @(desafio.Dificuldade == "Fácil" ? "bg-success" : desafio.Dificuldade == "Médio" ? "bg-warning text-dark" : "bg-danger")">
                            @desafio.Dificuldade
                        </span>

                    </div>

                    <p>@desafio.Descricao</p>

                    <p>⭐ @desafio.Pontos pontos</p>

                    <div class="progress mb-2" style="height: 12px;">

                        <div class="progress-bar bg-success"
                             role="progressbar"
                             style="width: @(percentual.ToString("F1", System.Globalization.CultureInfo.InvariantCulture))%"
                             aria-valuenow="@percentual"
                             aria-valuemin="0"
                             aria-valuemax="100">
                        </div>

                    </div>

                    <small class="mb-2">
                        Progresso:
                        @desafio.ProgressoAtual.ToString("0.##")
                        de
                        @desafio.MetaProgresso.ToString("0.##")
                        (@percentual.ToString("0")%)
                    </small>

                    @if (desafio.Concluido)
                    {
                        <span class="text-success fw-bold">
                            Desafio concluído! ✓
                        </span>
                    }
                    else
                    {
                        <span class="text-muted">
                            Continue realizando as atividades para completar este desafio.
                        </span>
                    }

                </div>
            }
        }
    }
    else
    {
        <p>Faça login para visualizar seus desafios.</p>
    }

</div>

@code {
    private List<Desafio> desafios = new();

    private string usuarioId = "";
    private string? mensagem;

    private string categoriaSelecionada = "Diário";

    private int pontuacao;

    private bool carregando = true;

    private int nivel = 1;
    private string nomeNivel = "Iniciante";

    private int xpDentroNivel;
    private int xpNecessarioNivel;
    private int xpFaltando;

    private double progressoNivel;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var estado = await AuthStateProvider.GetAuthenticationStateAsync();

            usuarioId = estado.User
                .FindFirst(ClaimTypes.NameIdentifier)?.Value ?? "";

            if (!string.IsNullOrWhiteSpace(usuarioId))
            {
                await CarregarDesafios();
            }
        }
        catch
        {
            mensagem = "Não foi possível carregar os desafios.";
        }
        finally
        {
            carregando = false;
        }
    }

    // Alterna entre desafios diários, semanais e mensais.
    private void SelecionarCategoria(string categoria)
    {
        categoriaSelecionada = categoria;
        mensagem = null;
    }

    // Calcula o nível de acordo com a pontuação acumulada.
private void AtualizarNivel()
{
    int[] limites = { 0, 50, 150, 300, 500 };

    string[] nomes =
    {
        "Iniciante",
        "Aprendiz",
        "Organizado",
        "Planejador",
        "Mestre financeiro"
    };

    if (pontuacao >= 500)
    {
        nivel = 5;
        nomeNivel = nomes[4];

        xpDentroNivel = 500;
        xpNecessarioNivel = 500;
        xpFaltando = 0;
        progressoNivel = 100;

        return;
    }

    for (int i = 0; i < limites.Length - 1; i++)
    {
        if (pontuacao >= limites[i] &&
            pontuacao < limites[i + 1])
        {
            nivel = i + 1;
            nomeNivel = nomes[i];

            xpDentroNivel = pontuacao - limites[i];

            xpNecessarioNivel = limites[i + 1] - limites[i];

            xpFaltando = limites[i + 1] - pontuacao;

            progressoNivel =
                (double)xpDentroNivel / xpNecessarioNivel * 100;

            break;
        }
    }
}

    // Carrega os desafios, atualiza a pontuação e verifica conquistas.
private async Task CarregarDesafios()
{
    desafios = await DesafioServico.CarregarDesafiosAsync(usuarioId);

    pontuacao = await Context.Desafios
        .Where(d => d.UsuarioId == usuarioId && d.Concluido)
        .SumAsync(d => (int?)d.Pontos) ?? 0;

    AtualizarNivel();

    await ConquistaServico.VerificarConquistasAsync(
        usuarioId,
        pontuacao);
}
}
