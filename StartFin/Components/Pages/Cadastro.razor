
@page "/cadastro"
@using StartFin.Modelos
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@inject UserManager<Usuario> UserManager
@inject NavigationManager Navigation

<PageTitle>Criar conta | StartFin</PageTitle>

<div class="container mt-5" style="max-width: 480px;">
    <h1>Criar conta</h1>
    <p>Comece sua jornada financeira com a StartFin!</p>

    <EditForm Model="novoUsuario" OnValidSubmit="Cadastrar">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label class="form-label">Nome completo</label>
            <InputText class="form-control"
                       @bind-Value="novoUsuario.NomeCompleto" />
        </div>

        <div class="mb-3">
            <label class="form-label">Data de nascimento *</label>

            <div class="row g-2">
                <div class="col-4">
                    <select class="form-select"
                            @bind="diaNascimento"
                            @bind:after="AtualizarDataNascimento">
                        <option value="">Dia</option>
                        @for (int dia = 1; dia <= DiasNoMes; dia++)
                        {
                            <option value="@dia">@dia.ToString("D2")</option>
                        }
                    </select>
                </div>

                <div class="col-4">
                    <select class="form-select"
                            @bind="mesNascimento"
                            @bind:after="AtualizarDataNascimento">
                        <option value="">Mês</option>
                        @for (int mes = 1; mes <= 12; mes++)
                        {
                            <option value="@mes">@System.Globalization.CultureInfo.GetCultureInfo("pt-BR").DateTimeFormat.GetMonthName(mes)</option>
                        }
                    </select>
                </div>

                <div class="col-4">
                    <select class="form-select"
                            @bind="anoNascimento"
                            @bind:after="AtualizarDataNascimento">
                        <option value="">Ano</option>
                        @for (int ano = DateTime.Today.Year; ano >= 1900; ano--)
                        {
                            <option value="@ano">@ano</option>
                        }
                    </select>
                </div>
            </div>
        </div>

        @if (IdadeCadastro.HasValue && IdadeCadastro.Value < 18)
        {
            <div class="mb-3">
                <label class="form-label">
                    Código familiar
                    @if (IdadeCadastro.Value < 16)
                    {
                        <span class="text-danger">*</span>
                    }
                    else
                    {
                        <span class="text-muted">(opcional)</span>
                    }
                </label>

                <InputText class="form-control"
                           @bind-Value="codigoFamiliar"
                           placeholder="Ex.: SF-XXXXXXXXXXXX" />

                <small class="text-muted">
                    @if (IdadeCadastro.Value < 16)
                    {
                        <span>
                            Para menores de 16 anos, o código de um responsável
                            é obrigatório.
                        </span>
                    }
                    else
                    {
                        <span>
                            Para quem tem 16 ou 17 anos, o vínculo familiar
                            é opcional, mas recomendado.
                        </span>
                    }
                </small>
            </div>
        }

        <div class="mb-3">
            <label class="form-label">Nome de usuário</label>
            <InputText class="form-control"
                       @bind-Value="nomeUsuario"
                       maxlength="30" />
        </div>

        <div class="mb-3">
            <label class="form-label">Senha</label>

            <div class="input-group">
                <InputText class="form-control"
                           type="@TipoSenha"
                           @bind-Value="senha" />

                <button class="btn btn-outline-secondary"
                        type="button"
                        @onclick="AlternarSenha"
                        aria-label="@(MostrarSenha ? "Ocultar senha" : "Mostrar senha")"
                        title="@(MostrarSenha ? "Ocultar senha" : "Mostrar senha")">
                    @if (MostrarSenha)
                    {
                        <svg xmlns="http://www.w3.org/2000/svg"
                             width="20" height="20"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2"
                             stroke-linecap="round"
                             stroke-linejoin="round">
                            <path d="M3 3l18 18" />
                            <path d="M10.6 10.6a2 2 0 0 0 2.8 2.8" />
                            <path d="M9.9 5.2A10.8 10.8 0 0 1 12 5c5 0 9 7 9 7a15.5 15.5 0 0 1-3 3.8" />
                            <path d="M6.6 6.6C4.1 8.2 3 12 3 12s4 7 9 7a10 10 0 0 0 4-.8" />
                        </svg>
                    }
                    else
                    {
                        <svg xmlns="http://www.w3.org/2000/svg"
                             width="20" height="20"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2"
                             stroke-linecap="round"
                             stroke-linejoin="round">
                            <path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7z" />
                            <circle cx="12" cy="12" r="3" />
                        </svg>
                    }
                </button>
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label">Confirmar senha</label>

            <div class="input-group">
                <InputText class="form-control"
                           type="@TipoConfirmarSenha"
                           @bind-Value="confirmarSenha" />

                <button class="btn btn-outline-secondary"
                        type="button"
                        @onclick="AlternarConfirmarSenha"
                        aria-label="@(MostrarConfirmarSenha ? "Ocultar confirmação da senha" : "Mostrar confirmação da senha")"
                        title="@(MostrarConfirmarSenha ? "Ocultar confirmação da senha" : "Mostrar confirmação da senha")">
                    @if (MostrarConfirmarSenha)
                    {
                        <svg xmlns="http://www.w3.org/2000/svg"
                             width="20" height="20"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2"
                             stroke-linecap="round"
                             stroke-linejoin="round">
                            <path d="M3 3l18 18" />
                            <path d="M10.6 10.6a2 2 0 0 0 2.8 2.8" />
                            <path d="M9.9 5.2A10.8 10.8 0 0 1 12 5c5 0 9 7 9 7a15.5 15.5 0 0 1-3 3.8" />
                            <path d="M6.6 6.6C4.1 8.2 3 12 3 12s4 7 9 7a10 10 0 0 0 4-.8" />
                        </svg>
                    }
                    else
                    {
                        <svg xmlns="http://www.w3.org/2000/svg"
                             width="20" height="20"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2"
                             stroke-linecap="round"
                             stroke-linejoin="round">
                            <path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7z" />
                            <circle cx="12" cy="12" r="3" />
                        </svg>
                    }
                </button>
            </div>
        </div>

        <button type="submit" class="btn btn-primary w-100">
            Criar minha conta
        </button>
    </EditForm>

    @if (!string.IsNullOrWhiteSpace(mensagem))
    {
        <div class="alert @classeMensagem mt-3" role="alert">
            @mensagem
        </div>
    }

    <p class="mt-3">
        Já tem conta?
        <a href="/entrar">Entrar</a>
    </p>
</div>

@code {
    private int? diaNascimento;
    private int? mesNascimento;
    private int? anoNascimento;

    private void AtualizarDataNascimento()
    {
        novoUsuario.DataNascimento = null;

        if (!mesNascimento.HasValue || !anoNascimento.HasValue)
            return;

        int diasNoMes = DateTime.DaysInMonth(
            anoNascimento.Value,
            mesNascimento.Value);

        if (diaNascimento.HasValue && diaNascimento.Value > diasNoMes)
        {
            diaNascimento = null;
            return;
        }

        if (!diaNascimento.HasValue)
            return;

        novoUsuario.DataNascimento = new DateTime(
            anoNascimento.Value,
            mesNascimento.Value,
            diaNascimento.Value);
    }

    private Usuario novoUsuario = new();
    private string nomeUsuario = "";
    private string senha = "";
    private string confirmarSenha = "";
    private string codigoFamiliar = "";
    private string mensagem = "";
    private string classeMensagem = "alert-danger";

    private bool MostrarSenha { get; set; }
    private bool MostrarConfirmarSenha { get; set; }

    private string TipoSenha => MostrarSenha ? "text" : "password";
    private string TipoConfirmarSenha => MostrarConfirmarSenha ? "text" : "password";

    private void AlternarSenha()
    {
        MostrarSenha = !MostrarSenha;
    }

    private void AlternarConfirmarSenha()
    {
        MostrarConfirmarSenha = !MostrarConfirmarSenha;
    }

    private int DiasNoMes
    {
        get
        {
            if (!mesNascimento.HasValue)
                return 31;

            int ano = anoNascimento ?? 2000;

            return DateTime.DaysInMonth(
                ano,
                mesNascimento.Value);
        }
    }

    private int? IdadeCadastro
    {
        get
        {
            if (!novoUsuario.DataNascimento.HasValue)
                return null;

            return CalcularIdade(novoUsuario.DataNascimento.Value);
        }
    }

    private int CalcularIdade(DateTime nascimento)
    {
        var hoje = DateTime.Today;
        int idade = hoje.Year - nascimento.Year;

        if (nascimento.Date > hoje.AddYears(-idade))
            idade--;

        return idade;
    }

    private async Task Cadastrar()
    {
        mensagem = "";

        if (string.IsNullOrWhiteSpace(novoUsuario.NomeCompleto) ||
            string.IsNullOrWhiteSpace(nomeUsuario))
        {
            mensagem = "Preencha todos os campos.";
            return;
        }

        if (!novoUsuario.DataNascimento.HasValue)
        {
            mensagem = "Informe sua data de nascimento.";
            return;
        }

        if (novoUsuario.DataNascimento.Value.Date > DateTime.Today)
        {
            mensagem = "A data de nascimento não pode ser futura.";
            return;
        }

        int idade = CalcularIdade(novoUsuario.DataNascimento.Value);

        if (idade < 18)
        {
            if (idade < 16 && string.IsNullOrWhiteSpace(codigoFamiliar))
            {
                mensagem = "O código familiar é obrigatório para menores de 16 anos.";
                return;
            }

            if (!string.IsNullOrWhiteSpace(codigoFamiliar))
            {
                string codigo = codigoFamiliar.Trim().ToUpperInvariant();

                var responsavel = await UserManager.Users
                    .FirstOrDefaultAsync(u =>
                        u.CodigoVinculoFamiliar == codigo);

                if (responsavel == null ||
                    !responsavel.DataNascimento.HasValue ||
                    CalcularIdade(responsavel.DataNascimento.Value) < 18)
                {
                    mensagem = "Código familiar inválido. Confira o código com seu responsável.";
                    return;
                }

                novoUsuario.ResponsavelId = responsavel.Id;
            }
        }

        nomeUsuario = nomeUsuario.Trim();

        if (nomeUsuario.Length < 3 || nomeUsuario.Length > 30)
        {
            mensagem = "O nome de usuário deve ter entre 3 e 30 caracteres.";
            return;
        }

        if (senha.Length < 8)
        {
            mensagem = "A senha precisa ter pelo menos 8 caracteres.";
            return;
        }

        if (senha != confirmarSenha)
        {
            mensagem = "As senhas não são iguais.";
            return;
        }

        var usuarioExistente = await UserManager.FindByNameAsync(nomeUsuario);

        if (usuarioExistente != null)
        {
            mensagem = "Esse nome de usuário já está em uso. Escolha outro.";
            return;
        }

        novoUsuario.UserName = nomeUsuario;
        novoUsuario.Email = null;

        novoUsuario.DataNascimento = DateTime.SpecifyKind(
            novoUsuario.DataNascimento.Value,
            DateTimeKind.Utc);

        var resultado = await UserManager.CreateAsync(novoUsuario, senha);

        if (resultado.Succeeded)
        {
            Navigation.NavigateTo("/entrar");
            return;
        }

        mensagem = string.Join(" ",
            resultado.Errors.Select(e => e.Description));
    }
}
