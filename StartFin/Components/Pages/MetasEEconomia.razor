        margin-top: 0;
    }

    .botao-voltar:hover {
        background: #dce7f5;
    }

    .conteudo-principal {
        background: white;
        padding: 28px;
        border-radius: 16px;
        box-shadow: 0 4px 18px rgba(0,0,0,0.04);
    }

    .conteudo-principal h2 {
        color: #172b4d;
        margin-top: 24px;
    }

    .conteudo-principal p {
        color: #718096;
        line-height: 1.7;
    }

    .passos {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 16px;
