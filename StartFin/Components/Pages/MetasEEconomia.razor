        color: #172b4d;
        font-size: 34px;
        font-weight: 800;
    }

    .topo-pagina p {
        color: #718096;
    }

    .botao-voltar {
        display: inline-block;
        background: #edf2f7;
        color: #2455a4;
        padding: 10px 16px;
        border-radius: 10px;
