    }

    .passo {
        background: #f4f7fb;
        padding: 18px;
        border-radius: 12px;
    }

    .passo strong {
        color: #172b4d;
    }

    .exemplo-meta {
        background: #f4f7fb;
        padding: 22px;
        border-radius: 12px;
        margin-top: 16px;
    }

    .exemplo-meta h3 {
        color: #172b4d;
    }

    .barra-progresso {
        height: 12px;
        background: #dce5ef;
        border-radius: 20px;
        overflow: hidden;
