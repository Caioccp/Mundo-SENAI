@page "/educacao-financeira/quiz/metas-e-economia"

@using Microsoft.AspNetCore.Components.Authorization
@using StartFin.Dados
@using StartFin.Modelos
@using System.Security.Claims

@inject StartFinContext Context
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Quiz - Metas e Economia | StartFin</PageTitle>

<div class="quiz-container">

    <a href="/educacao-financeira/metas-e-economia" class="voltar">
        ← Voltar para a aula
    </a>

    <div class="cabecalho">
        <span class="etiqueta">STARTFIN • EDUCAÇÃO FINANCEIRA</span>
        <h1>Quiz: Metas e Economia</h1>
        <p>
            Teste seus conhecimentos sobre como definir objetivos,
            economizar dinheiro e planejar suas conquistas.
        </p>
        <span class="nivel">Nível intermediário • 10 questões</span>
    </div>

    @if (!Finalizado)
    {
        <div class="progresso">
            <div class="progresso-texto">
                <span>Pergunta @(Indice + 1) de @Perguntas.Count</span>
                <span>@Pontos pontos</span>
            </div>

            <div class="barra">
                <div class="barra-preenchida"
                     style="width: @(((Indice + 1) * 100.0 / Perguntas.Count).ToString(System.Globalization.CultureInfo.InvariantCulture))%">
                </div>
            </div>
        </div>

        <section class="pergunta-card">

            <span class="numero">QUESTÃO @(Indice + 1)</span>

            <h2>@Perguntas[Indice].Enunciado</h2>

            <div class="opcoes">
                @foreach (var opcao in Perguntas[Indice].Opcoes)
                {
                    <button class="opcao @(Selecionada == opcao ? "selecionada" : "")"
                            disabled="@Respondida"
                            @onclick="() => Selecionar(opcao)">
                        @opcao
                    </button>
                }
            </div>

            @if (Respondida)
            {
                <div class="feedback @(Acertou ? "correto" : "incorreto")">
                    <strong>
                        @(Acertou ? "Resposta correta!" : "Resposta incorreta!")
                    </strong>
                    <p>@Perguntas[Indice].Explicacao</p>
                </div>
            }

            <div class="acoes">
                @if (!Respondida)
                {
                    <button class="botao-principal"
                            disabled="@string.IsNullOrEmpty(Selecionada)"
                            @onclick="ConfirmarResposta">
                        Confirmar resposta
                    </button>
                }
                else
                {
                    <button class="botao-principal" @onclick="Proxima">
                        @(Indice == Perguntas.Count - 1
                            ? "Ver resultado"
                            : "Próxima pergunta")
                    </button>
                }
            </div>

        </section>
    }
    else
    {
        <section class="resultado-card">

            <span class="etiqueta">QUIZ CONCLUÍDO</span>
            <h2>Você terminou!</h2>

            <div class="pontuacao">
                @Pontos <small>/ @Perguntas.Count</small>
            </div>

            <p>Você acertou @Pontos de @Perguntas.Count perguntas.</p>

            <p class="mensagem">@MensagemResultado</p>

            @if (ResultadoSalvo)
            {
                <p class="salvo">
                    ✓ Seu resultado foi salvo na sua conta!
                </p>
            }
            else
            {
                <p class="aviso">@MensagemSalvamento</p>
            }

            <button class="botao-principal" @onclick="Reiniciar">
                Refazer quiz
            </button>

            <a href="/educacao-financeira/metas-e-economia" class="link-aula">
                Voltar para a aula
            </a>

        </section>
    }

</div>

<style>
    .quiz-container {
        max-width: 850px;
        margin: 35px auto;
        padding: 20px;
        color: #172033;
    }

    .voltar, .link-aula {
        color: #087f5b;
        text-decoration: none;
        font-weight: 700;
    }

    .cabecalho {
        margin: 30px 0;
    }

    .etiqueta, .numero {
        color: #087f5b;
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 1px;
    }

    .cabecalho h1 {
        font-size: 32px;
        margin: 10px 0;
    }

    .cabecalho p {
        color: #64748b;
        line-height: 1.6;
    }

    .nivel {
        display: inline-block;
        margin-top: 10px;
        padding: 7px 12px;
        background: #ecfdf5;
        color: #087f5b;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 700;
    }

    .progresso {
        margin-bottom: 20px;
    }

    .progresso-texto {
        display: flex;
        justify-content: space-between;
        margin-bottom: 8px;
        font-weight: 700;
    }

    .barra {
        height: 9px;
        background: #e2e8f0;
        border-radius: 20px;
        overflow: hidden;
    }

    .barra-preenchida {
        height: 100%;
        background: #10b981;
        border-radius: 20px;
        transition: width .3s;
    }

    .pergunta-card, .resultado-card {
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 18px;
        padding: 30px;
        box-shadow: 0 5px 20px #00000008;
    }

    .pergunta-card h2 {
        font-size: 22px;
        line-height: 1.6;
        margin: 15px 0 25px;
    }

    .opcoes {
        display: grid;
        gap: 12px;
    }

    .opcao {
        width: 100%;
        text-align: left;
        padding: 16px;
        border: 1px solid #cbd5e1;
        border-radius: 12px;
        background: white;
        color: #172033;
        cursor: pointer;
        font-size: 15px;
        line-height: 1.5;
        transition: .2s;
    }

    .opcao:hover:not(:disabled) {
        border-color: #10b981;
        background: #f0fdf4;
    }

    .opcao.selecionada {
        border: 2px solid #059669;
        background: #ecfdf5;
    }

    .opcao:disabled {
        cursor: default;
        opacity: 1;
    }

    .feedback {
        margin-top: 20px;
        padding: 16px;
        border-radius: 12px;
        line-height: 1.6;
    }

    .feedback p {
        margin-bottom: 0;
    }

    .correto {
        background: #dcfce7;
        color: #166534;
    }

    .incorreto {
        background: #fee2e2;
        color: #991b1b;
    }

    .acoes {
        margin-top: 25px;
        display: flex;
        justify-content: flex-end;
    }

    .botao-principal {
        border: none;
        border-radius: 10px;
        padding: 14px 24px;
        background: #087f5b;
        color: white;
        font-weight: 700;
        cursor: pointer;
        font-size: 15px;
    }

    .botao-principal:hover {
        background: #066849;
    }

    .botao-principal:disabled {
        background: #94a3b8;
        cursor: not-allowed;
    }

    .resultado-card {
        text-align: center;
        padding: 45px 25px;
    }

    .resultado-card h2 {
        font-size: 28px;
    }

    .pontuacao {
        font-size: 65px;
        font-weight: 800;
        color: #087f5b;
        margin: 15px 0;
    }

    .pontuacao small {
        font-size: 25px;
        color: #64748b;
    }

    .mensagem {
        margin: 20px 0;
        color: #475569;
    }

    .salvo {
        color: #087f5b;
        font-weight: 700;
    }

    .aviso {
        color: #b45309;
    }

    .resultado-card .botao-principal {
        display: block;
        margin: 25px auto 15px;
    }

    @@media (max-width: 600px) {
        .cabecalho h1 {
            font-size: 26px;
        }

        .pergunta-card {
            padding: 20px;
        }

        .pergunta-card h2 {
            font-size: 19px;
        }
    }
</style>

@code {
    private int Indice = 0;
    private int Pontos = 0;

    private bool Respondida = false;
    private bool Acertou = false;
    private bool Finalizado = false;
    private bool ResultadoSalvo = false;

    private string Selecionada = string.Empty;
    private string MensagemResultado = string.Empty;
    private string MensagemSalvamento = string.Empty;

    private List<Pergunta> Perguntas = new()
{
    new(
        "Marina quer comprar uma bicicleta de R$ 900,00 em 6 meses. Ela já possui R$ 180,00 guardados. Quanto precisa economizar por mês para alcançar a meta?",
        new()
        {
            "R$ 100,00 por mês, considerando o valor que ainda falta.",
            "R$ 120,00 por mês, considerando o preço total.",
            "R$ 150,00 por mês, considerando o prazo disponível.",
            "R$ 180,00 por mês, considerando sua economia atual."
        },
        "Marina ainda precisa juntar R$ 720,00. Dividindo esse valor pelos 6 meses disponíveis, ela precisa economizar R$ 120,00 por mês.",
        "R$ 120,00 por mês, considerando o preço total."
    ),

    new(
        "Pedro estabeleceu uma meta de economizar R$ 1.200,00 em um ano. Após quatro meses, percebeu que guardou apenas R$ 250,00. Qual atitude seria mais adequada?",
        new()
        {
            "Desistir da meta porque o planejamento inicial não foi cumprido.",
            "Avaliar suas economias e reorganizar os valores que consegue guardar.",
            "Utilizar crédito para completar imediatamente o valor planejado.",
            "Ignorar o progresso e manter o mesmo planejamento."
        },
        "Quando uma meta não está avançando como esperado, é importante analisar a situação e ajustar o planejamento à realidade financeira.",
        "Avaliar suas economias e reorganizar os valores que consegue guardar."
    ),

    new(
        "Uma pessoa possui R$ 500,00 disponíveis e pretende dividir esse valor entre uma meta de curto prazo e uma reserva para imprevistos. Qual decisão demonstra melhor organização?",
        new()
        {
            "Destinar todo o dinheiro à compra desejada, sem considerar imprevistos.",
            "Gastar uma parte e deixar o restante sem finalidade definida.",
            "Escolher a compra mais cara e adiar qualquer economia.",
            "Definir quanto será destinado a cada objetivo, considerando suas prioridades."
        },
        "Dividir o dinheiro de acordo com prioridades permite avançar em diferentes objetivos sem deixar de considerar possíveis necessidades futuras.",
        "Definir quanto será destinado a cada objetivo, considerando suas prioridades."
    ),

    new(
        "Carlos pretende comprar um notebook de R$ 2.400,00. Ele consegue guardar R$ 200,00 por mês. Qual prazo representa o tempo necessário para atingir a meta, sem considerar rendimentos?",
        new()
        {
            "Em 10 meses, mantendo a economia planejada.",
            "Em 11 meses, considerando o valor mensal disponível.",
            "Em 12 meses, mantendo depósitos mensais constantes.",
            "Em 14 meses, considerando o preço total do produto."
        },
        "Dividindo R$ 2.400,00 por R$ 200,00, o resultado é 12 meses de economia.",
        "Em 12 meses, mantendo depósitos mensais constantes."
    ),

    new(
        "Juliana guardou R$ 400,00 para uma viagem, mas precisou utilizar R$ 100,00 em uma despesa inesperada. Como deve avaliar essa situação?",
        new()
        {
            "Como uma falha definitiva que invalida todo o planejamento.",
            "Como um motivo para abandonar todas as metas financeiras.",
            "Como um imprevisto que exige revisar o prazo e continuar economizando.",
            "Como uma oportunidade para aumentar os gastos planejados."
        },
        "Imprevistos podem acontecer. O mais importante é reorganizar o planejamento e retomar a economia quando possível.",
        "Como um imprevisto que exige revisar o prazo e continuar economizando."
    ),

    new(
        "Uma meta exige R$ 750,00. Até agora, foram economizados R$ 525,00. Qual percentual do objetivo já foi alcançado?",
        new()
        {
            "65%, considerando a parte já economizada.",
            "70%, considerando o valor guardado em relação à meta.",
            "75%, considerando o valor que ainda falta.",
            "80%, considerando o total estabelecido como objetivo."
        },
        "Dividindo R$ 525,00 por R$ 750,00 e multiplicando por 100, chegamos a 70% da meta.",
        "70%, considerando o valor guardado em relação à meta."
    ),

    new(
        "Fernanda possui duas metas: comprar um livro em dois meses e juntar dinheiro para um computador em dois anos. Como esses objetivos podem ser classificados?",
        new()
        {
            "Ambos são objetivos de curto prazo, pois envolvem compras.",
            "O livro é de longo prazo e o computador é de médio prazo.",
            "Ambos são objetivos de longo prazo, pois exigem economia.",
            "O livro é de curto prazo e o computador é de longo prazo."
        },
        "O prazo de dois meses caracteriza uma meta de curto prazo, enquanto dois anos representam uma meta de longo prazo.",
        "O livro é de curto prazo e o computador é de longo prazo."
    ),

    new(
        "André consegue economizar R$ 80,00 por mês, mas deseja atingir uma meta de R$ 600,00 em apenas seis meses. Qual análise está correta?",
        new()
        {
            "Ele alcançará a meta, pois economizará R$ 600,00 no período.",
            "Ele ultrapassará a meta, pois juntará R$ 680,00.",
            "Ele juntará R$ 480,00 e precisará ajustar o valor mensal ou o prazo.",
            "Ele precisará economizar apenas R$ 20,00 por mês."
        },
        "Economizando R$ 80,00 durante seis meses, André acumulará R$ 480,00. Faltarão R$ 120,00 para alcançar a meta.",
        "Ele juntará R$ 480,00 e precisará ajustar o valor mensal ou o prazo."
    ),

    new(
        "Uma pessoa acompanha suas metas mensalmente e percebe que está economizando mais do que havia planejado. Qual pode ser uma boa decisão?",
        new()
        {
            "Aumentar todas as metas imediatamente, sem avaliar suas prioridades.",
            "Reavaliar o planejamento e verificar se é possível antecipar algum objetivo.",
            "Interromper os registros porque a economia está funcionando.",
            "Gastar o valor excedente sem considerar outros objetivos."
        },
        "Acompanhar o progresso permite identificar oportunidades de ajuste. Se houver condições, antecipar uma meta pode ser uma boa decisão.",
        "Reavaliar o planejamento e verificar se é possível antecipar algum objetivo."
    ),

    new(
        "Sofia deseja economizar para três objetivos diferentes, mas possui uma quantia limitada disponível por mês. Qual estratégia pode ajudá-la a manter um planejamento sustentável?",
        new()
        {
            "Dividir o dinheiro igualmente entre todas as metas, independentemente dos prazos.",
            "Priorizar apenas a meta mais cara e ignorar as demais.",
            "Definir prioridades, considerar os prazos e distribuir valores compatíveis com seu orçamento.",
            "Guardar valores diferentes a cada mês sem acompanhar os resultados."
        },
        "Um planejamento sustentável considera os prazos, a importância de cada objetivo e o dinheiro realmente disponível para economizar.",
        "Definir prioridades, considerar os prazos e distribuir valores compatíveis com seu orçamento."
    )
};

    private void Selecionar(string opcao)
    {
        if (!Respondida)
        {
            Selecionada = opcao;
        }
    }

    private void ConfirmarResposta()
    {
        if (string.IsNullOrEmpty(Selecionada) || Respondida)
            return;

        Acertou = Selecionada == Perguntas[Indice].RespostaCorreta;

        if (Acertou)
            Pontos++;

        Respondida = true;
    }

    private async Task Proxima()
    {
        if (Indice < Perguntas.Count - 1)
        {
            Indice++;
            Selecionada = string.Empty;
            Respondida = false;
            Acertou = false;
        }
        else
        {
            Finalizado = true;

            MensagemResultado = Pontos switch
            {
                10 => "Excelente! Você demonstrou domínio sobre metas financeiras e economia.",
                >= 8 => "Muito bom! Você sabe como planejar objetivos e economizar.",
                >= 6 => "Bom esforço! Você já conhece vários conceitos, mas ainda pode melhorar.",
                _ => "Continue praticando! Revise a aula e tente novamente para fortalecer seus conhecimentos."
            };

            await SalvarResultadoAsync();
        }
    }

    private async Task SalvarResultadoAsync()
    {
        try
        {
            var estado = await AuthenticationStateProvider.GetAuthenticationStateAsync();

            var usuarioId = estado.User.FindFirst(
                ClaimTypes.NameIdentifier)?.Value;

            if (string.IsNullOrEmpty(usuarioId))
            {
                MensagemSalvamento = "Entre na sua conta para salvar seu resultado.";
                return;
            }

            var resultado = new ResultadoQuiz
            {
                UsuarioId = usuarioId,
                IdentificadorQuiz = "metas-e-economia",
                Pontos = Pontos,
                TotalPerguntas = Perguntas.Count,
                DataConclusao = DateTime.UtcNow
            };

            Context.ResultadosQuiz.Add(resultado);
            await Context.SaveChangesAsync();

            ResultadoSalvo = true;
        }
        catch
        {
            MensagemSalvamento = "Não foi possível salvar o resultado. Tente novamente mais tarde.";
        }
    }

    private void Reiniciar()
    {
        Indice = 0;
        Pontos = 0;
        Respondida = false;
        Acertou = false;
        Finalizado = false;
        ResultadoSalvo = false;

        Selecionada = string.Empty;
        MensagemResultado = string.Empty;
        MensagemSalvamento = string.Empty;
    }

    private class Pergunta
    {
        public string Enunciado { get; set; }
        public List<string> Opcoes { get; set; }
        public string Explicacao { get; set; }
        public string RespostaCorreta { get; set; }

        public Pergunta(
            string enunciado,
            List<string> opcoes,
            string explicacao,
            string respostaCorreta)
        {
            Enunciado = enunciado;
            Opcoes = opcoes;
            Explicacao = explicacao;
            RespostaCorreta = respostaCorreta;
        }
    }
}