@code {
    private bool MostrarResultado = false;
    private bool Carregando = false;

    private ResultadoQuiz? UltimoResultado;
    private string MensagemResultado = "";

    private async Task ConsultarResultado()
    {
        MostrarResultado = true;
        Carregando = true;
        UltimoResultado = null;
        MensagemResultado = "";

        try
        {
            var estado = await AuthProvider.GetAuthenticationStateAsync();

            var usuarioId = estado.User.FindFirst(
                ClaimTypes.NameIdentifier)?.Value;

            if (string.IsNullOrEmpty(usuarioId))
            {
                MensagemResultado = "Entre na sua conta para consultar seu resultado.";
                return;
            }

            UltimoResultado = await Context.ResultadosQuiz
                .Where(r => r.UsuarioId == usuarioId &&
                            r.IdentificadorQuiz == "seguranca-financeira-digital")
                .OrderByDescending(r => r.DataConclusao)
                .FirstOrDefaultAsync();

            if (UltimoResultado == null)
            {
                MensagemResultado = "Você ainda não concluiu este quiz.";
            }
        }
        catch
        {
            MensagemResultado = "Não foi possível consultar seu resultado.";
        }
        finally
        {
            Carregando = false;
        }
    }
}