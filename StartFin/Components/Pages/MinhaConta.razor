
@page "/minha-conta"
@using StartFin.Dados
@using StartFin.Modelos
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.Authorization
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@inject UserManager<Usuario> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject PreferenciasNotificacaoServico PreferenciasServico
@inject NavigationManager Navigation
@inject IPasswordHasher<Usuario> PasswordHasher


<PageTitle>Minha Conta | StartFin</PageTitle>

<style>
    .conta-container {
        max-width: 850px;
        margin: auto;
    }

    .conta-banner {
        background: linear-gradient(120deg, #075bff, #5426a8);
        color: white;
        border-radius: 18px;
        padding: 30px;
        margin-bottom: 25px;
        box-shadow: 0 5px 18px rgba(40, 70, 160, 0.18);
    }

    .conta-banner p {
        color: rgba(255,255,255,0.85);
    }

    .conta-card {
        background: white;
        border: 1px solid #edf0f7;
        border-radius: 15px;
        padding: 20px;
        height: 100%;
        box-shadow: 0 3px 12px rgba(0,0,0,0.04);
        transition: transform 0.2s, box-shadow 0.2s;
    }

    .conta-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 7px 18px rgba(0,0,0,0.08);
    }

    .conta-icone {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        background: #edf3ff;
        color: #075bff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        margin-bottom: 14px;
    }

    .conta-label {
        color: #788398;
        font-size: 13px;
        display: block;
        margin-bottom: 5px;
    }

    .conta-valor {
        color: #17233b;
        font-weight: 600;
        overflow-wrap: anywhere;
    }

    .conta-secao {
        color: #17233b;
        font-weight: 700;
        margin-bottom: 15px;
    }

    .conta-botao {
        background: #075bff;
        color: white;
        border: none;
        border-radius: 10px;
        padding: 10px 18px;
        font-weight: 600;
    }

    .conta-botao:hover {
        background: #0648ca;
        color: white;
    }

    .conta-cancelar {
        background: #edf0f7;
        color: #17233b;
        border: none;
        border-radius: 10px;
        padding: 10px 18px;
    }
</style>

<div class="container py-5 conta-container">

    <!-- CABEÇALHO -->
    <div class="conta-banner">
        <span class="small fw-bold">STARTFIN • ÁREA DO USUÁRIO</span>
        <h1 class="fw-bold mt-3">Minha conta</h1>
        <p class="mb-0">
            Suas informações pessoais em um só lugar.
        </p>
    </div>

    @if (carregando)
    {
        <p>Carregando suas informações...</p>
    }
    else if (usuario is null)
    {
        <div class="alert alert-danger">
            Não foi possível carregar os dados da sua conta.
        </div>
    }
    else
    {
        <!-- BOAS-VINDAS -->
        <div class="conta-card mb-4">
            <span class="conta-label">BEM-VINDO(A) À STARTFIN</span>
            <h3 class="fw-bold mb-2">@usuario.NomeCompleto</h3>
            <p class="text-muted mb-0">
                Que bom ter você por aqui!
                Continue acompanhando sua jornada financeira.
            </p>
        </div>

        <!-- INFORMAÇÕES PESSOAIS -->
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="conta-secao mb-0">Informações pessoais</h5>

            @if (!editando)
            {
                <button class="conta-botao" @onclick="AbrirEdicao">
                    ✏️ Editar perfil
                </button>
            }
        </div>

        <!-- FORMULÁRIO DE EDIÇÃO -->
        @if (editando)
        {
            <div class="conta-card mb-4">
                <h5 class="conta-secao">Editar perfil</h5>

                <div class="mb-3">
                    <label class="form-label">Nome completo</label>
                    <input class="form-control" @bind="nomeEditado" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Nome de usuário</label>
                    <input class="form-control"
                           @bind="usuarioEditado"
                           maxlength="30" />
                </div>

                <button class="conta-botao"
                        @onclick="SalvarEdicao"
                        disabled="@salvando">
                    @(salvando ? "Salvando..." : "Salvar alterações")
                </button>

                <button class="conta-cancelar ms-2"
                        @onclick="CancelarEdicao"
                        disabled="@salvando">
                    Cancelar
                </button>

                @if (!string.IsNullOrWhiteSpace(mensagem))
                {
                    <div class="alert @(sucesso ? "alert-success" : "alert-danger") mt-3">
                        @mensagem
                    </div>
                }
            </div>
        }

        <!-- CARTÕES COM OS DADOS -->
        <div class="row g-3 mb-4">

            <div class="col-md-6">
                <div class="conta-card">
                    <div class="conta-icone">👤</div>
                    <span class="conta-label">NOME COMPLETO</span>
                    <div class="conta-valor">@usuario.NomeCompleto</div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="conta-card">
                    <div class="conta-icone">🎮</div>
                    <span class="conta-label">NOME DE USUÁRIO</span>
                    <div class="conta-valor">@usuario.UserName</div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="conta-card">
                    <div class="conta-icone">📅</div>
                    <span class="conta-label">DATA DE CRIAÇÃO</span>
                    <div class="conta-valor">
                        @usuario.DataCriacao.ToLocalTime().ToString("dd/MM/yyyy")
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="conta-card">
                    <div class="conta-icone">🎂</div>
                    <span class="conta-label">IDADE</span>
                    <div class="conta-valor">
                        @(Idade.HasValue ? $"{Idade} anos" : "Não informada")
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="conta-card">
                    <div class="conta-icone">🆔</div>
                    <span class="conta-label">ID DO USUÁRIO</span>
                    <div class="conta-valor">@usuario.Id</div>
                </div>
            </div>

        </div>

        <!-- CONTA FAMILIAR -->
@if (Idade.HasValue && Idade.Value >= 18)
{
    <div class="conta-card mb-4">
        <h5 class="conta-secao">👨‍👩‍👧 Conta familiar</h5>

        <p class="text-muted">
            Gere um código para permitir que um familiar vincule
            sua conta à dele.
        </p>

        @if (!string.IsNullOrWhiteSpace(usuario.CodigoVinculoFamiliar))
        {
            <span class="conta-label">SEU CÓDIGO FAMILIAR</span>
            <div class="conta-valor mb-3">
                @usuario.CodigoVinculoFamiliar
            </div>
        }
        else
        {
            <button class="conta-botao"
                    @onclick="GerarCodigoFamiliar"
                    disabled="@gerandoCodigoFamiliar">
                @(gerandoCodigoFamiliar ? "Gerando..." : "Gerar código familiar")
            </button>
        }

        @if (!string.IsNullOrWhiteSpace(mensagemVinculo))
        {
            <div class="alert alert-danger mt-3">
                @mensagemVinculo
            </div>
        }
    </div>
}

        
        <!-- CÓDIGO DE RECUPERAÇÃO -->
        @if (Idade.HasValue && Idade.Value >= 18)
        {
            <div class="conta-card mb-4">
                <h5 class="conta-secao">🔐 Código de recuperação</h5>

                <p class="text-muted">
                    Esse código será necessário para recuperar sua conta
                    caso você esqueça sua senha. Guarde-o em um lugar seguro
                    e nunca compartilhe com outras pessoas.
                </p>

                @if (!string.IsNullOrWhiteSpace(codigoRecuperacaoGerado))
                {
                    <div class="alert alert-success">
                        <strong>Seu novo código de recuperação:</strong>
                        <div class="fs-5 fw-bold mt-2">
                            @codigoRecuperacaoGerado
                        </div>
                        <p class="mb-0 mt-2">
                            Copie e guarde esse código agora.
                            Ele não será exibido novamente.
                        </p>
                    </div>
                }
                else if (!string.IsNullOrWhiteSpace(usuario.CodigoRecuperacaoSenhaHash))
                {
                    <div class="alert alert-info">
                        Você já possui um código de recuperação cadastrado.
                        Se não o guardou, poderá gerar outro.
                    </div>
                }
                else
                {
                    <p class="text-muted">
                        Você ainda não possui um código de recuperação.
                    </p>
                }

                <div class="mb-3">
                    <label class="form-label">
                        Confirme sua senha atual
                    </label>
                    <input type="password"
                           class="form-control"
                           @bind="senhaParaCodigoRecuperacao"
                           autocomplete="current-password" />
                </div>

                <button class="conta-botao"
                        @onclick="GerarCodigoRecuperacao"
                        disabled="@gerandoCodigoRecuperacao">
                    @(gerandoCodigoRecuperacao
                        ? "Gerando..."
                        : string.IsNullOrWhiteSpace(usuario.CodigoRecuperacaoSenhaHash)
                            ? "Gerar código de recuperação"
                            : "Gerar novo código")
                </button>

                @if (!string.IsNullOrWhiteSpace(mensagemCodigoRecuperacao))
                {
                    <div class="alert alert-danger mt-3">
                        @mensagemCodigoRecuperacao
                    </div>
                }
            </div>
        }


        <!-- SEGURANÇA DA CONTA -->
        <div class="conta-card mb-4">
            <h5 class="conta-secao">Segurança da conta</h5>

            <p class="text-muted">
                Mantenha sua conta protegida atualizando sua senha.
            </p>

            <button class="conta-botao" @onclick="AbrirAlteracaoSenha">
                🔒 Alterar senha
            </button>
        </div>

        <!-- FORMULÁRIO DE ALTERAÇÃO DE SENHA -->
        @if (alterandoSenha)
        {
            <div class="conta-card mb-4">
                <h5 class="conta-secao">Alterar senha</h5>

                <div class="mb-3">
                    <label class="form-label">Senha atual</label>
                    <input type="password" class="form-control" @bind="senhaAtual" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Nova senha</label>
                    <input type="password" class="form-control" @bind="novaSenha" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Confirmar nova senha</label>
                    <input type="password" class="form-control" @bind="confirmarNovaSenha" />
                </div>

                <button class="conta-botao"
                        @onclick="AlterarSenha"
                        disabled="@salvandoSenha">
                    @(salvandoSenha ? "Salvando..." : "Salvar nova senha")
                </button>

                <button class="conta-cancelar ms-2"
                        @onclick="CancelarAlteracaoSenha"
                        disabled="@salvandoSenha">
                    Cancelar
                </button>

                @if (!string.IsNullOrWhiteSpace(mensagemSenha))
                {
                    <div class="alert @(sucessoSenha ? "alert-success" : "alert-danger") mt-3">
                        @mensagemSenha
                    </div>
                }
            </div>
        }

        <!-- PREFERÊNCIAS DE NOTIFICAÇÃO -->
        @if (preferencias != null)
        {
            <div class="conta-card mb-4">
                <h5 class="conta-secao">🔔 Preferências de notificação</h5>

                <p class="text-muted">
                    Escolha quais avisos deseja receber da StartFin.
                </p>

                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox"
                           @bind="preferencias.AvisosMetas" />
                    <label class="form-check-label">
                        Avisos sobre metas de economia
                    </label>
                </div>

                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox"
                           @bind="preferencias.NovidadesEducacao" />
                    <label class="form-check-label">
                        Novidades da educação financeira
                    </label>
                </div>

                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox"
                           @bind="preferencias.LembretesObjetivos" />
                    <label class="form-check-label">
                        Lembretes de objetivos financeiros
                    </label>
                </div>

                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox"
                           @bind="preferencias.ComunicadosGerais" />
                    <label class="form-check-label">
                        Comunicados gerais do StartFin
                    </label>
                </div>

                <button class="conta-botao"
                        @onclick="SalvarPreferencias"
                        disabled="@salvandoPreferencias">
                    @(salvandoPreferencias ? "Salvando..." : "Salvar preferências")
                </button>

                @if (!string.IsNullOrWhiteSpace(mensagemPreferencias))
                {
                    <div class="alert @(sucessoPreferencias ? "alert-success" : "alert-danger") mt-3">
                        @mensagemPreferencias
                    </div>
                }
            </div>
        }

        

<!-- GERENCIAR CONTA -->
<div class="conta-card mb-4">
    <h5 class="conta-secao">Gerenciar conta</h5>

    <p class="text-muted">
        Gerencie seu acesso à StartFin.
    </p>

    <div class="d-flex flex-wrap gap-2">

        <form method="post" action="/logout?destino=entrar">
            <AntiforgeryToken />
            <button type="submit" class="conta-botao"
                    style="width: 245px; height: 50px;">
                🔄 Entrar com outra conta
            </button>
        </form>

        <form method="post" action="/logout?destino=cadastro">
            <AntiforgeryToken />
            <button type="submit" class="btn btn-success"
                    style="width: 245px; height: 50px;">
                ➕ Criar outra conta
            </button>
        </form>

        <form method="post" action="/logout">
            <AntiforgeryToken />
            <button type="submit" class="btn btn-danger"
                    style="width: 245px; height: 50px;">
                ↪ Sair da conta
            </button>
        </form>

    </div>
</div>

<!-- EXCLUIR CONTA -->
<div class="conta-card mb-4">
    <h5 class="conta-secao text-danger">Excluir minha conta</h5>

    <p class="text-muted">
        Essa ação apagará permanentemente sua conta e os dados
        associados a ela. Essa operação não poderá ser desfeita.
    </p>

    @if (!string.IsNullOrWhiteSpace(mensagemExclusao))
{
    <div class="alert alert-danger">
        @mensagemExclusao
    </div>
}

    @if (!exibindoExclusao)
    {
        <button class="btn btn-danger"
                @onclick="() => exibindoExclusao = true">
            🗑️ Excluir minha conta
        </button>
    }
    else
    {
        <form method="post" action="/excluir-conta">
            <AntiforgeryToken />

            <div class="alert alert-warning">
                Para confirmar, informe sua senha atual e digite
                <strong>EXCLUIR</strong> no campo de confirmação.
            </div>

            <div class="mb-3">
                <label class="form-label">Senha atual</label>
                <input type="password"
                       name="senha"
                       class="form-control"
                       required />
            </div>

            <div class="mb-3">
                <label class="form-label">Digite EXCLUIR</label>
                <input type="text"
                       name="confirmacao"
                       class="form-control"
                       required />
            </div>

            <button type="submit" class="btn btn-danger">
                Confirmar exclusão permanente
            </button>

            <button type="button"
                    class="conta-cancelar ms-2"
                    @onclick="() => exibindoExclusao = false">
                Cancelar
            </button>
        </form>
    }
</div>

}

</div>

@code {
    private Usuario? usuario;

    private int? Idade

{
    get
    {
        if (usuario?.DataNascimento == null)
            return null;

        var hoje = DateTime.Today;
        var nascimento = usuario.DataNascimento.Value.Date;

        int idade = hoje.Year - nascimento.Year;

        if (nascimento.Date > hoje.AddYears(-idade))
            idade--;

        return idade;
    }
}
    private PreferenciasNotificacao? preferencias;

    private bool gerandoCodigoFamiliar = false;
    private string mensagemVinculo = "";
    private string mensagemExclusao = "";

    private bool exibindoExclusao = false;

    private string senhaParaCodigoRecuperacao = "";
    private string codigoRecuperacaoGerado = "";
    private string mensagemCodigoRecuperacao = "";
    private bool gerandoCodigoRecuperacao = false;

    private bool salvandoPreferencias = false;
    private bool sucessoPreferencias = false;
    private string mensagemPreferencias = "";

    private bool carregando = true;
    private bool editando = false;
    private bool salvando = false;
    private bool sucesso = false;

    private string nomeEditado = "";
    private string usuarioEditado = "";
    private string mensagem = "";

    private bool alterandoSenha = false;
    private bool salvandoSenha = false;
    private bool sucessoSenha = false;

    private string senhaAtual = "";
    private string novaSenha = "";
    private string confirmarNovaSenha = "";
    private string mensagemSenha = "";

    private async Task GerarCodigoFamiliar()
{
    if (usuario is null || !Idade.HasValue || Idade.Value < 18)
        return;

    if (!string.IsNullOrWhiteSpace(usuario.CodigoVinculoFamiliar))
        return;

    gerandoCodigoFamiliar = true;
    mensagemVinculo = "";

    try
    {
        usuario.CodigoVinculoFamiliar =
            "SF-" + Guid.NewGuid().ToString("N")[..12].ToUpperInvariant();

        var resultado = await UserManager.UpdateAsync(usuario);

        if (!resultado.Succeeded)
        {
            usuario.CodigoVinculoFamiliar = null;
            mensagemVinculo = "Não foi possível gerar o código. Tente novamente.";
        }
    }
    finally
    {
        gerandoCodigoFamiliar = false;
    }
}

    
private async Task GerarCodigoRecuperacao()
{
    mensagemCodigoRecuperacao = "";
    codigoRecuperacaoGerado = "";

    if (usuario is null || !Idade.HasValue || Idade.Value < 18)
        return;

    if (string.IsNullOrWhiteSpace(senhaParaCodigoRecuperacao))
    {
        mensagemCodigoRecuperacao = "Informe sua senha atual.";
        return;
    }

    gerandoCodigoRecuperacao = true;

    try
    {
        var senhaCorreta = await UserManager.CheckPasswordAsync(
            usuario, senhaParaCodigoRecuperacao);

        if (!senhaCorreta)
        {
            mensagemCodigoRecuperacao = "A senha atual está incorreta.";
            return;
        }

        // Gera um código aleatório de 20 caracteres.
        var novoCodigo = "SF-" +
            Convert.ToHexString(
                System.Security.Cryptography.RandomNumberGenerator.GetBytes(10));

        // Guarda somente o hash no banco.
        var hashAnterior = usuario.CodigoRecuperacaoSenhaHash;

        usuario.CodigoRecuperacaoSenhaHash =
            PasswordHasher.HashPassword(usuario, novoCodigo);

        var resultado = await UserManager.UpdateAsync(usuario);

        if (!resultado.Succeeded)
        {
            usuario.CodigoRecuperacaoSenhaHash = hashAnterior;
            mensagemCodigoRecuperacao =
                "Não foi possível gerar o código. Tente novamente.";
            return;
        }

        // Exibe o código somente nesta sessão.
        codigoRecuperacaoGerado = novoCodigo;
        senhaParaCodigoRecuperacao = "";
    }
    finally
    {
        gerandoCodigoRecuperacao = false;
    }
}


    protected override async Task OnInitializedAsync()
    {
        try
        {

            var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(
    Navigation.ToAbsoluteUri(Navigation.Uri).Query);

if (query.TryGetValue("exclusao", out var status))
{
    mensagemExclusao = status.ToString() switch
    {
        "senha" => "A senha atual está incorreta.",
        "confirmacao" => "Confirme digitando EXCLUIR e informe sua senha.",
        _ => "Não foi possível excluir sua conta. Tente novamente."
    };
}

            var estado = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            usuario = await UserManager.GetUserAsync(estado.User);

            if (usuario != null)
            {
                preferencias = await PreferenciasServico.ObterAsync(usuario.Id);
            }
        }
        finally
        {
            carregando = false;
        }
    }

    private void AbrirEdicao()
    {
        nomeEditado = usuario!.NomeCompleto;
        usuarioEditado = usuario.UserName ?? "";
        mensagem = "";
        sucesso = false;
        editando = true;
    }

    private void CancelarEdicao()
    {
        editando = false;
        mensagem = "";
    }

    private async Task SalvarEdicao()
    {
        mensagem = "";
        sucesso = false;

        if (usuario is null)
            return;

        if (string.IsNullOrWhiteSpace(nomeEditado) ||
            string.IsNullOrWhiteSpace(usuarioEditado))
        {
            mensagem = "Preencha todos os campos.";
            return;
        }

        nomeEditado = nomeEditado.Trim();
        usuarioEditado = usuarioEditado.Trim();

        if (usuarioEditado.Length < 3 || usuarioEditado.Length > 30)
        {
            mensagem = "O nome de usuário deve ter entre 3 e 30 caracteres.";
            return;
        }

        salvando = true;

        try
        {
            var usuarioExistente = await UserManager.FindByNameAsync(usuarioEditado);

            if (usuarioExistente != null && usuarioExistente.Id != usuario.Id)
            {
                mensagem = "Esse nome de usuário já está em uso. Escolha outro.";
                return;
            }

            var resultadoNomeUsuario = await UserManager.SetUserNameAsync(usuario, usuarioEditado);

            if (!resultadoNomeUsuario.Succeeded)
            {
                mensagem = string.Join(" ", resultadoNomeUsuario.Errors.Select(e => e.Description));
                return;
            }

            usuario.NomeCompleto = nomeEditado;

            var resultado = await UserManager.UpdateAsync(usuario);

            if (resultado.Succeeded)
            {
                sucesso = true;
                mensagem = "Perfil atualizado com sucesso!";
                editando = false;
            }
            else
            {
                mensagem = string.Join(" ", resultado.Errors.Select(e => e.Description));
            }
        }
        finally
        {
            salvando = false;
        }
    }

    private void AbrirAlteracaoSenha()
    {
        senhaAtual = "";
        novaSenha = "";
        confirmarNovaSenha = "";
        mensagemSenha = "";
        sucessoSenha = false;
        alterandoSenha = true;
    }

    private void CancelarAlteracaoSenha()
    {
        alterandoSenha = false;
        senhaAtual = "";
        novaSenha = "";
        confirmarNovaSenha = "";
        mensagemSenha = "";
    }

    private async Task AlterarSenha()
    {
        mensagemSenha = "";
        sucessoSenha = false;

        if (usuario is null)
            return;

        if (string.IsNullOrWhiteSpace(senhaAtual) ||
            string.IsNullOrWhiteSpace(novaSenha) ||
            string.IsNullOrWhiteSpace(confirmarNovaSenha))
        {
            mensagemSenha = "Preencha todos os campos.";
            return;
        }

        if (novaSenha != confirmarNovaSenha)
        {
            mensagemSenha = "As novas senhas não coincidem.";
            return;
        }

        salvandoSenha = true;

        try
        {
            var resultado = await UserManager.ChangePasswordAsync(usuario, senhaAtual, novaSenha);

            if (resultado.Succeeded)
            {
                sucessoSenha = true;
                mensagemSenha = "Senha alterada com sucesso!";
                senhaAtual = "";
                novaSenha = "";
                confirmarNovaSenha = "";
                alterandoSenha = false;
            }
            else
            {
                mensagemSenha = string.Join(" ", resultado.Errors.Select(e =>
                    e.Code == "PasswordMismatch"
                        ? "A senha atual está incorreta."
                        : e.Code == "PasswordTooShort"
                            ? "A nova senha deve ter pelo menos 8 caracteres."
                            : e.Code == "PasswordRequiresDigit"
                                ? "A nova senha deve conter pelo menos um número."
                                : e.Code == "PasswordRequiresLower"
                                    ? "A nova senha deve conter pelo menos uma letra minúscula."
                                    : e.Description));
            }
        }
        finally
        {
            salvandoSenha = false;
        }
    }

    private async Task SalvarPreferencias()
    {
        mensagemPreferencias = "";
        sucessoPreferencias = false;

        if (preferencias is null)
            return;

        salvandoPreferencias = true;

        try
        {
            await PreferenciasServico.SalvarAsync(preferencias);
            sucessoPreferencias = true;
            mensagemPreferencias = "Preferências salvas com sucesso!";
        }
        catch
        {
            mensagemPreferencias = "Não foi possível salvar as preferências. Tente novamente.";
        }
        finally
        {
            salvandoPreferencias = false;
        }
    }
}
