@code {
    private const string IdentificadorQuiz = "comecando-do-zero";

    private bool MostrarResultado = false;
    private bool Carregando = false;

    private ResultadoQuiz? UltimoResultado;
    private ResultadoQuiz? TentativaEmAndamento;

    private string MensagemResultado = "";

    private int PerguntasRespondidas;
    private int PerguntasRestantes;
    private int PerguntaAtual;

    private int PercentualProgresso =>
        TentativaEmAndamento == null ||
        TentativaEmAndamento.TotalPerguntas <= 0
            ? 0
            : Math.Clamp(
                PerguntasRespondidas * 100 /
                TentativaEmAndamento.TotalPerguntas,
                0,
                100);

    protected override async Task OnInitializedAsync()
    {
        await CarregarDadosQuizAsync();
    }

    private async Task ConsultarResultado()
    {
        MostrarResultado = true;
        await CarregarDadosQuizAsync();
    }

    private async Task CarregarDadosQuizAsync()
    {
        Carregando = true;

        UltimoResultado = null;
        TentativaEmAndamento = null;
        MensagemResultado = "";

        PerguntasRespondidas = 0;
        PerguntasRestantes = 0;
        PerguntaAtual = 0;

        try
        {
            var estado = await AuthProvider.GetAuthenticationStateAsync();

            var usuarioId = estado.User.FindFirst(
                ClaimTypes.NameIdentifier)?.Value;

            if (string.IsNullOrEmpty(usuarioId))
            {
                MensagemResultado =
                    "Entre na sua conta para consultar seu progresso.";
                return;
            }

            TentativaEmAndamento = await Context.ResultadosQuiz
                .AsNoTracking()
                .Where(r => r.UsuarioId == usuarioId &&
                            r.IdentificadorQuiz == IdentificadorQuiz &&
                            r.Status == "Em andamento")
                .OrderByDescending(r => r.DataInicio)
                .FirstOrDefaultAsync();

            UltimoResultado = await Context.ResultadosQuiz
                .AsNoTracking()
                .Where(r => r.UsuarioId == usuarioId &&
                            r.IdentificadorQuiz == IdentificadorQuiz &&
                            r.Status == "Concluída")
                .OrderByDescending(r => r.DataConclusao)
                .FirstOrDefaultAsync();

            if (TentativaEmAndamento != null)
            {
                var total = Math.Max(
                    1,
                    TentativaEmAndamento.TotalPerguntas);

                var indice = Math.Clamp(
                    TentativaEmAndamento.IndicePerguntaAtual,
                    0,
                    total - 1);

                var respondida = false;

                if (!string.IsNullOrEmpty(TentativaEmAndamento.RespostasJson))
                {
                    var progresso = JsonSerializer.Deserialize<ProgressoSalvo>(
                        TentativaEmAndamento.RespostasJson);

                    if (progresso != null)
                    {
                        indice = Math.Clamp(
                            progresso.Indice,
                            0,
                            total - 1);

                        respondida = progresso.Respondida;
                    }
                }

                PerguntasRespondidas = indice + (respondida ? 1 : 0);

                PerguntasRestantes = Math.Max(
                    0,
                    total - PerguntasRespondidas);

                PerguntaAtual = Math.Min(
                    indice + 1,
                    total);
            }

            if (TentativaEmAndamento == null && UltimoResultado == null)
            {
                MensagemResultado =
                    "Você ainda não começou este quiz. Que tal testar seus conhecimentos?";
            }
        }
        catch
        {
            MensagemResultado =
                "Não foi possível consultar seu progresso.";
        }
        finally
        {
            Carregando = false;
        }
    }

    private class ProgressoSalvo
    {
        public int Indice { get; set; }
        public bool Respondida { get; set; }
    }
}
