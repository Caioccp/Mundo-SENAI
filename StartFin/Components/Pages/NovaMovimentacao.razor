
@page "/nova-movimentacao"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using System.Globalization
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using StartFin.Servicos

@inject CarteiraServico CarteiraServico
@inject AuthenticationStateProvider AuthProvider

<PageTitle>Fazer movimentação | StartFin</PageTitle>

<div class="pagina">

    <header class="topo">
        <div>
            <span class="etiqueta">MINHA CARTEIRA</span>
            <h1>Fazer movimentação 💰</h1>
            <p>Escolha o tipo de movimentação que deseja registrar.</p>
        </div>

        <a href="/" class="botao-voltar">← Voltar ao início</a>
    </header>

    @if (Carregando)
    {
        <div class="cartao">
            <p>Carregando sua carteira...</p>
        </div>
    }
    else
    {
        <section class="saldo">
            <span>Saldo atual</span>
            <h2>@Saldo.ToString("C2", Cultura)</h2>
            <p>Seu saldo é atualizado automaticamente.</p>
        </section>

        <section class="opcoes">
            <button class="opcao entrada @(Tipo == "Entrada" ? "selecionada" : "")"
                    @onclick='() => SelecionarTipo("Entrada")'>
                <span class="icone">↑</span>
                <span class="opcao-titulo">Entrada</span>
                <span class="opcao-descricao">Dinheiro que entrou na sua carteira.</span>
            </button>

            <button class="opcao saida @(Tipo == "Saída" ? "selecionada" : "")"
                    @onclick='() => SelecionarTipo("Saída")'>
                <span class="icone">↓</span>
                <span class="opcao-titulo">Saída</span>
                <span class="opcao-descricao">Dinheiro que saiu da sua carteira.</span>
            </button>
        </section>

        <section class="cartao">
            <h2>Registrar @Tipo.ToLower()</h2>
            <p>Preencha os dados da movimentação.</p>

            <div class="formulario">

                <label>Descrição</label>
                <input @bind="Descricao"
                       placeholder="Ex.: Mesada, compra de um livro..." />

                <label>Valor (R$)</label>
                <input type="number"
                       step="0.01"
                       min="0.01"
                       @bind="Valor"
                       placeholder="0,00" />

                <button class="botao-registrar"
                        @onclick="RegistrarAsync"
                        disabled="@Salvando">
                    @(Salvando ? "Registrando..." : "Registrar movimentação")
                </button>

                @if (!string.IsNullOrWhiteSpace(Mensagem))
                {
                    <p class="mensagem">@Mensagem</p>
                }

            </div>
        </section>
    }
</div>

<style>
    .pagina {
        width: 100%;
        padding: 30px;
        color: #26364a;
        box-sizing: border-box;
    }

    .topo {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 20px;
        margin-bottom: 30px;
    }

    .etiqueta {
        color: #16a085;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 1px;
    }

    .topo h1 {
        margin: 8px 0;
        color: #172b4d;
        font-size: 34px;
        font-weight: 800;
    }

    .topo p, .cartao p {
        color: #718096;
    }

    .botao-voltar {
        background: #edf2f7;
        color: #2455a4;
        padding: 10px 16px;
        border-radius: 10px;
        text-decoration: none;
        font-weight: 700;
        white-space: nowrap;
    }

    .saldo {
        background: #087f5b;
        color: white;
        padding: 28px;
        border-radius: 16px;
        margin-bottom: 22px;
    }

    .saldo span {
        font-size: 14px;
    }

    .saldo h2 {
        font-size: 36px;
        margin: 10px 0;
    }

    .saldo p {
        margin: 0;
        opacity: 0.85;
    }

    .opcoes {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 20px;
        margin-bottom: 22px;
    }

    .opcao {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 9px;
        padding: 24px;
        border: 2px solid #e2e8f0;
        border-radius: 16px;
        background: white;
        text-align: left;
        cursor: pointer;
        transition: 0.2s;
    }

    .opcao:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 16px rgba(0,0,0,0.06);
    }

    .opcao.entrada.selecionada {
        border-color: #087f5b;
        background: #f0fdf7;
    }

    .opcao.saida.selecionada {
        border-color: #dc5757;
        background: #fff5f5;
    }

    .icone {
        font-size: 28px;
        font-weight: 800;
    }

    .entrada .icone,
    .entrada .opcao-titulo {
        color: #087f5b;
    }

    .saida .icone,
    .saida .opcao-titulo {
        color: #dc5757;
    }

    .opcao-titulo {
        font-size: 20px;
        font-weight: 800;
    }

    .opcao-descricao {
        color: #718096;
        font-size: 14px;
    }

    .cartao {
        width: 100%;
        box-sizing: border-box;
        background: white;
        padding: 26px;
        border-radius: 16px;
        box-shadow: 0 4px 18px rgba(0,0,0,0.04);
        margin-bottom: 22px;
    }

    .cartao h2 {
        color: #172b4d;
        margin-top: 0;
    }

    .formulario {
        display: flex;
        flex-direction: column;
        gap: 10px;
        width: 100%;
        margin-top: 20px;
    }

    .formulario label {
        color: #26364a;
        font-weight: 700;
        margin-top: 8px;
    }

    .formulario input {
        width: 100%;
        box-sizing: border-box;
        padding: 13px;
        border: 1px solid #dce5ef;
        border-radius: 9px;
        font-size: 15px;
    }

    .botao-registrar {
        margin-top: 12px;
        padding: 14px;
        border: none;
        border-radius: 10px;
        background: #087f5b;
        color: white;
        font-weight: 700;
        cursor: pointer;
        font-size: 15px;
    }

    .botao-registrar:hover {
        background: #066849;
    }

    .botao-registrar:disabled {
        opacity: 0.6;
        cursor: not-allowed;
    }

    .mensagem {
        font-weight: 600;
    }

    @@media (max-width: 650px) {
        .pagina {
            padding: 18px;
        }

        .topo {
            flex-direction: column;
        }

        .topo h1 {
            font-size: 28px;
        }

        .opcoes {
            grid-template-columns: 1fr;
        }
    }
</style>

@code {
    private static readonly CultureInfo Cultura =
        CultureInfo.GetCultureInfo("pt-BR");

    private string UsuarioId = string.Empty;
    private string Tipo = "Entrada";
    private string Descricao = string.Empty;
    private decimal Valor;

    private decimal Saldo;
    private bool Carregando = true;
    private bool Salvando;

    private string Mensagem = string.Empty;

    private void SelecionarTipo(string tipo)
    {
        Tipo = tipo;
        Mensagem = string.Empty;
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var estado = await AuthProvider.GetAuthenticationStateAsync();

            UsuarioId = estado.User.FindFirst(
                ClaimTypes.NameIdentifier)?.Value ?? string.Empty;

            if (string.IsNullOrEmpty(UsuarioId))
                return;

            var carteira = await CarteiraServico
                .ObterOuCriarCarteiraAsync(UsuarioId);

            Saldo = carteira.SaldoDisponivel;
        }
        catch
        {
            Mensagem = "Não foi possível carregar sua carteira.";
        }
        finally
        {
            Carregando = false;
        }
    }

    private async Task RegistrarAsync()
    {
        Mensagem = string.Empty;

        if (string.IsNullOrWhiteSpace(Descricao))
        {
            Mensagem = "Informe uma descrição.";
            return;
        }

        if (Valor <= 0)
        {
            Mensagem = "Informe um valor maior que zero.";
            return;
        }

        Salvando = true;

        try
        {
            await CarteiraServico.RegistrarMovimentacaoAsync(
                UsuarioId,
                Tipo,
                Descricao.Trim(),
                Valor
            );

            var carteira = await CarteiraServico
                .ObterOuCriarCarteiraAsync(UsuarioId);

            Saldo = carteira.SaldoDisponivel;

            Descricao = string.Empty;
            Valor = 0;

            Mensagem = "Movimentação registrada com sucesso!";
        }
        catch (Exception ex)
        {
            Mensagem = ex.Message;
        }
        finally
        {
            Salvando = false;
        }
    }
}
