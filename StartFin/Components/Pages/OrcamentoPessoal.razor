    }

    .introducao h2, .conteudo-card h2,
    .resumo h2, .quiz-card h2 {
        color: #172b65;
        font-size: 21px;
        margin-bottom: 14px;
    }

    .introducao p, .conteudo-card p,
    .resumo li, .quiz-card p {
        color: #475569;
        line-height: 1.7;
    }

    .exemplo {
        background: #f0fdf4;
        border-left: 4px solid #10b981;
        padding: 16px;
        border-radius: 8px;
        margin-top: 15px;
    }

    .exemplo h3 {
        color: #087f5b;
        font-size: 16px;
        margin-bottom: 8px;
    }

    .exemplo p {
        margin-bottom: 8px;
    }

    .exemplo ul {
