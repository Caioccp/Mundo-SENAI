        font-weight: 700;
    }

    .aula-cabecalho {
        margin: 30px 0;
    }

    .etiqueta {
        color: #087f5b;
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 1px;
    }

    .aula-cabecalho h1 {
        font-size: 32px;
        margin: 10px 0;
    }

    .aula-cabecalho p {
        color: #64748b;
        line-height: 1.6;
    }

    .nivel {
        display: inline-block;
        margin-top: 10px;
        padding: 7px 12px;
        background: #ecfdf5;
        color: #087f5b;
        border-radius: 20px;
        font-size: 12px;
