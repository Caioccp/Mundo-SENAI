
@page "/educacao-financeira/orcamento-pessoal"

@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using System.Security.Claims
@using StartFin.Dados
@using StartFin.Modelos

@inject StartFinContext Context
@inject AuthenticationStateProvider AuthProvider

<PageTitle>Orçamento pessoal | StartFin</PageTitle>

<div class="aula-container">

    <a href="/educacao-financeira" class="voltar">← Voltar aos conteúdos</a>

    <header class="aula-cabecalho">
        <span class="etiqueta">EDUCAÇÃO FINANCEIRA • PLANEJAMENTO</span>
        <h1>Orçamento pessoal 📊</h1>
        <p>
            Aprenda a organizar seu dinheiro, controlar seus gastos
            e planejar suas escolhas financeiras.
        </p>
        <span class="nivel">Nível básico • Aula 6</span>
    </header>

    <section class="introducao">
        <h2>O que é um orçamento pessoal?</h2>
        <p>
            O orçamento pessoal é uma forma de organizar o dinheiro
            que recebemos e os gastos que temos durante determinado período.
        </p>
        <p>
            Com ele, conseguimos entender para onde nosso dinheiro está indo,
            identificar possíveis excessos e planejar objetivos.
        </p>
    </section>

    <section class="conteudo-card">
        <h2>1. Conheça suas receitas</h2>
        <p>
            Receitas são todos os valores que recebemos. Elas representam
            a entrada de dinheiro no nosso orçamento.
        </p>

        <div class="exemplo">
            <h3>Exemplos de receitas</h3>
            <ul>
                <li>Mesada recebida da família.</li>
                <li>Dinheiro recebido por trabalhos realizados.</li>
                <li>Presentes em dinheiro.</li>
                <li>Bolsa ou auxílio, quando aplicável.</li>
            </ul>
        </div>

        <div class="dica">
            <strong>Dica:</strong>
            Anote todas as entradas de dinheiro, mesmo quando os valores
            forem pequenos.
        </div>
    </section>

    <section class="conteudo-card">
        <h2>2. Identifique suas despesas</h2>
        <p>
            Despesas são os valores que gastamos. Elas podem ser divididas
            em diferentes categorias.
        </p>

        <div class="exemplo">
            <h3>Despesas fixas</h3>
            <p>
                São gastos que costumam acontecer regularmente
                e possuem valores iguais ou semelhantes.
            </p>
            <p>Exemplo: mensalidade de um serviço ou assinatura.</p>
        </div>

        <div class="exemplo">
            <h3>Despesas variáveis</h3>
            <p>
                São gastos que podem mudar de valor ou frequência
                dependendo do período.
            </p>
            <p>Exemplo: alimentação fora de casa, passeios e compras.</p>
        </div>

        <div class="dica">
            <strong>Atenção:</strong>
            Mesmo os pequenos gastos devem ser registrados.
            Quando somados, eles podem representar uma parte importante
            do dinheiro utilizado.
        </div>
    </section>

    <section class="conteudo-card">
        <h2>3. Organize seu orçamento</h2>
        <p>
            Depois de identificar suas receitas e despesas, organize
            essas informações para entender sua situação financeira.
        </p>

        <div class="exemplo">
            <h3>Exemplo prático</h3>

            <p><strong>Receita mensal:</strong> R$ 300,00</p>
            <p><strong>Despesas:</strong></p>

            <ul>
                <li>Transporte: R$ 60,00</li>
                <li>Lanche: R$ 50,00</li>
                <li>Assinatura: R$ 20,00</li>
            </ul>

            <p><strong>Total de despesas:</strong> R$ 130,00</p>
            <p><strong>Valor restante:</strong> R$ 170,00</p>
        </div>

        <p>
            Nesse exemplo, a pessoa ainda possui R$ 170,00 depois
            de pagar as despesas registradas. Esse valor pode ser
            planejado para economias, objetivos ou outros gastos.
        </p>
    </section>

    <section class="conteudo-card">
        <h2>4. Planeje seus gastos</h2>
        <p>
            Ter dinheiro disponível não significa que precisamos
            gastar tudo imediatamente. Planejar ajuda a tomar decisões
            mais conscientes.
        </p>

        <ul>
            <li>Priorize despesas importantes.</li>
            <li>Defina limites para seus gastos.</li>
            <li>Reserve uma parte do dinheiro para seus objetivos.</li>
            <li>Evite comprometer todo o dinheiro antes de recebê-lo.</li>
            <li>Revise seu planejamento quando sua situação mudar.</li>
        </ul>
    </section>

    <section class="conteudo-card">
        <h2>5. Acompanhe seu orçamento</h2>
        <p>
            Organizar o orçamento uma única vez não é suficiente.
            É importante acompanhar as entradas e saídas de dinheiro
            para perceber se o planejamento está funcionando.
        </p>

        <div class="dica">
            <strong>Uma boa prática:</strong>
            Anote seus gastos ao longo da semana e reserve um momento
            para conferir se está seguindo o planejamento.
        </div>

        <p>
            Se perceber que está gastando mais do que deveria,
            procure entender o motivo e ajuste suas escolhas.
        </p>
    </section>

    <section class="resumo">
        <h2>O que aprendemos?</h2>
        <ul>
            <li>Orçamento pessoal organiza receitas e despesas.</li>
            <li>Receitas representam entradas de dinheiro.</li>
            <li>Despesas representam saídas de dinheiro.</li>
            <li>Despesas podem ser fixas ou variáveis.</li>
            <li>Planejar ajuda a controlar os gastos.</li>
            <li>Acompanhar o orçamento permite fazer ajustes.</li>
        </ul>
    </section>

    <section class="quiz-card">
        <span class="etiqueta">TESTE SEUS CONHECIMENTOS</span>
        <h2>Hora de praticar! 🧠</h2>
        <p>
            Responda a 10 questões sobre orçamento pessoal
            e descubra quanto você aprendeu nesta aula.
        </p>

        <a href="/educacao-financeira/quiz/orcamento-pessoal" class="botao-quiz">
            Fazer quiz →
        </a>

        <button type="button" class="botao-resultado" @onclick="MostrarUltimoResultado">
            Ver último resultado
        </button>

        @if (ExibindoUltimoResultado)
        {
            <div class="resultado-ultimo">
                @if (UltimoResultado != null)
                {
                    <h3>Seu último resultado</h3>

                    <p>
                        Você acertou
                        <strong>@UltimoResultado.Pontos de @UltimoResultado.TotalPerguntas</strong>
                        questões.
                    </p>

                    <p>
                        Concluído em:
                        @UltimoResultado.DataConclusao?.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                    </p>
                }
                else
                {
                    <p>Você ainda não concluiu este quiz.</p>
                }
            </div>
        }
    </section>

</div>

@code {
    private ResultadoQuiz? UltimoResultado;
    private bool ExibindoUltimoResultado = false;

    private async Task MostrarUltimoResultado()
    {
        var estado = await AuthProvider.GetAuthenticationStateAsync();
        var usuarioId = estado.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        if (string.IsNullOrEmpty(usuarioId))
        {
            UltimoResultado = null;
            ExibindoUltimoResultado = true;
            return;
        }

        UltimoResultado = await Context.ResultadosQuiz
            .Where(r => r.UsuarioId == usuarioId &&
                        r.IdentificadorQuiz == "orcamento-pessoal" &&
                        r.Status == "Concluída")
            .OrderByDescending(r => r.DataConclusao)
            .FirstOrDefaultAsync();

        ExibindoUltimoResultado = true;
    }
}

