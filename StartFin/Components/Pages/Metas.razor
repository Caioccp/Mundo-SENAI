
@page "/metas"
@using Npgsql
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Authorization

@using System.Security.Claims

@inject IConfiguration Configuration
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Minhas metas | StartFin</PageTitle>

<div class="cabecalho-metas">
    <h1>Minhas metas 🎯</h1>
    <a href="/" class="botao-voltar">← Voltar ao Menu</a>
</div>

<p>Planeje hoje as conquistas de amanhã.</p>

<section class="card p-4 mb-4">
    <h2>Nova meta</h2>

    <EditForm Model="novaMeta"
              OnValidSubmit="CadastrarMeta"
              FormName="NovaMetaForm"
              Enhance="false">

        <div class="mb-3">
            <label class="form-label">Nome da meta</label>
            <InputText class="form-control"
                       @bind-Value="novaMeta.Nome"
                       placeholder="Ex.: Comprar um fone" />
        </div>

        <div class="mb-3">
            <label class="form-label">Quanto você quer juntar? (R$)</label>
            <input class="form-control"
                   type="number"
                   step="0.01"
                   min="0.01"
                   @bind="novaMeta.ValorObjetivo"
                   @bind:event="oninput" />
        </div>

        <button class="btn btn-success botao-criar-meta" type="submit">
            Criar meta
        </button>
    </EditForm>

    @if (!string.IsNullOrWhiteSpace(mensagem))
    {
        <p class="mt-3">@mensagem</p>
    }
</section>

<h2>Suas metas</h2>

@if (metas.Count == 0)
{
    <p>Você ainda não tem metas cadastradas.</p>
}
else
{
    @foreach (var meta in metas)
    {
        var percentual = meta.ValorObjetivo > 0
            ? Math.Min(100, (double)(meta.ValorGuardado / meta.ValorObjetivo * 100))
            : 0;

        <section class="card p-3 mb-3" @key="meta.Id">
            <h3>@meta.Nome</h3>

            <p>
                Guardado: @meta.ValorGuardado.ToString("C2", cultura)
                de @meta.ValorObjetivo.ToString("C2", cultura)
            </p>

            <div class="progress" style="height: 18px;">
                <div class="progress-bar bg-success"
                     role="progressbar"
                     style="width: @(percentual)%"
                     aria-valuenow="@percentual"
                     aria-valuemin="0"
                     aria-valuemax="100">
                </div>
            </div>

            <small class="mt-2">
                @percentual.ToString("F1", cultura)% concluído
            </small>

            @if (meta.ValorGuardado >= meta.ValorObjetivo)
            {
                <p class="text-success mt-2">Meta concluída! 🎉</p>
            }

            <button class="btn btn-danger mt-3"
                    @onclick="() => ExcluirMeta(meta.Id)">
                Excluir
            </button>
        </section>
    }
}

@code {
    private readonly System.Globalization.CultureInfo cultura =
        System.Globalization.CultureInfo.GetCultureInfo("pt-BR");

    private List<MetaEconomia> metas = new();
    private MetaEconomia novaMeta = new();
    private string? mensagem;
    private string usuarioId = "";

    private string ConnectionString =>
        Configuration.GetConnectionString("DefaultConnection")
        ?? throw new InvalidOperationException(
            "A conexão com o banco não foi configurada.");

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var estado = await AuthStateProvider.GetAuthenticationStateAsync();

            usuarioId = estado.User.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? "";
            mensagem = $"ID da conta conectada: {usuarioId}";

            if (string.IsNullOrWhiteSpace(usuarioId))
            {
                mensagem = "Não foi possível identificar o usuário conectado.";
                return;
            }

            await using var conexao = new NpgsqlConnection(ConnectionString);
            await conexao.OpenAsync();

            var criarTabela = new NpgsqlCommand(
                @"CREATE TABLE IF NOT EXISTS metas_economia (
                    id SERIAL PRIMARY KEY,
                    nome VARCHAR(100) NOT NULL,
                    valor_objetivo NUMERIC(12,2) NOT NULL
                        CHECK (valor_objetivo > 0),
                    valor_guardado NUMERIC(12,2) NOT NULL DEFAULT 0,
                    usuario_id TEXT
                );

                ALTER TABLE metas_economia
                ADD COLUMN IF NOT EXISTS usuario_id TEXT;

                CREATE UNIQUE INDEX IF NOT EXISTS
                idx_metas_usuario_nome
                ON metas_economia (usuario_id, LOWER(BTRIM(nome)))
                WHERE usuario_id IS NOT NULL;",
                conexao);

            await criarTabela.ExecuteNonQueryAsync();

            await CarregarMetas(conexao);
        }
        catch (Exception)
        {
            mensagem = "Não foi possível carregar as metas. Verifique a conexão com o banco.";
        }
    }

    private async Task CadastrarMeta()
    {
        if (string.IsNullOrWhiteSpace(novaMeta.Nome) ||
            novaMeta.ValorObjetivo <= 0)
        {
            mensagem = "Informe um nome e um valor maior que zero.";
            return;
        }

        if (string.IsNullOrWhiteSpace(usuarioId))
        {
            mensagem = "Não foi possível identificar sua conta.";
            return;
        }

        try
        {
            await using var conexao = new NpgsqlConnection(ConnectionString);
            await conexao.OpenAsync();

            var nome = novaMeta.Nome.Trim();

            var verificarDuplicada = new NpgsqlCommand(
                @"SELECT COUNT(*)
                  FROM metas_economia
                  WHERE usuario_id = @usuarioId
                  AND LOWER(BTRIM(nome)) = LOWER(@nome);",
                conexao);

            verificarDuplicada.Parameters.AddWithValue("@usuarioId", usuarioId);
            verificarDuplicada.Parameters.AddWithValue("@nome", nome);

            var quantidade = (long)(await verificarDuplicada.ExecuteScalarAsync() ?? 0L);

            if (quantidade > 0)
            {
                mensagem = "Você já possui uma meta com esse nome.";
                return;
            }

            var comando = new NpgsqlCommand(
                @"INSERT INTO metas_economia
                  (nome, valor_objetivo, usuario_id)
                  VALUES (@nome, @valor, @usuarioId);",
                conexao);

            comando.Parameters.AddWithValue("@nome", nome);
            comando.Parameters.AddWithValue("@valor", novaMeta.ValorObjetivo);
            comando.Parameters.AddWithValue("@usuarioId", usuarioId);

            await comando.ExecuteNonQueryAsync();

            novaMeta = new MetaEconomia();

            await CarregarMetas(conexao);

            mensagem = "Meta cadastrada com sucesso!";
        }
        catch (PostgresException ex) when (ex.SqlState == "23505")
        {
            mensagem = "Você já possui uma meta com esse nome.";
        }
        catch (Exception)
        {
            mensagem = "Erro ao cadastrar a meta. Tente novamente.";
        }
    }

    private async Task CarregarMetas(NpgsqlConnection conexao)
    {
        metas.Clear();

        var consulta = new NpgsqlCommand(
            @"SELECT id, nome, valor_objetivo, valor_guardado
              FROM metas_economia
              WHERE usuario_id = @usuarioId
              ORDER BY id DESC;",
            conexao);

        consulta.Parameters.AddWithValue("@usuarioId", usuarioId);

        await using var leitor = await consulta.ExecuteReaderAsync();

        while (await leitor.ReadAsync())
        {
            metas.Add(new MetaEconomia
            {
                Id = leitor.GetInt32(0),
                Nome = leitor.GetString(1),
                ValorObjetivo = leitor.GetDecimal(2),
                ValorGuardado = leitor.GetDecimal(3)
            });
        }
    }

    private async Task ExcluirMeta(int id)
    {
        try
        {
            await using var conexao = new NpgsqlConnection(ConnectionString);
            await conexao.OpenAsync();

            var comando = new NpgsqlCommand(
                @"DELETE FROM metas_economia
                  WHERE id = @id AND usuario_id = @usuarioId;",
                conexao);

            comando.Parameters.AddWithValue("@id", id);
            comando.Parameters.AddWithValue("@usuarioId", usuarioId);

            await comando.ExecuteNonQueryAsync();

            await CarregarMetas(conexao);

            mensagem = "Meta excluída com sucesso!";
        }
        catch (Exception)
        {
            mensagem = "Erro ao excluir a meta.";
        }
    }

    private class MetaEconomia
    {
        public int Id { get; set; }
        public string Nome { get; set; } = "";
        public decimal ValorObjetivo { get; set; }
        public decimal ValorGuardado { get; set; }
    }
}
