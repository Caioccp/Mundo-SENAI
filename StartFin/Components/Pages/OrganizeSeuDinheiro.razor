    background: #edf3ff;
    border-radius: 16px;
    padding: 25px;
    margin-bottom: 30px;
}

.destaque h2,
.exemplo h2,
.dica h2 {
    margin-top: 0;
    font-size: 22px;
}

.secao {
    margin-bottom: 35px;
}

.secao h2 {
    font-size: 22px;
    margin-bottom: 18px;
}

.cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 15px;
}

.card {
    background: #f4f7fd;
    border: 1px solid #e5eaf5;
    border-radius: 14px;
    padding: 22px;
}

