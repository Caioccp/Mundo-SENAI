    font-size: 30px;
}

.card h3,
.passo h3 {
    color: #172b65;
    margin-bottom: 8px;
}

.passo {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    background: #f4f7fd;
    border: 1px solid #e5eaf5;
    border-radius: 12px;
    padding: 18px;
    margin-bottom: 12px;
}

.passo > span {
    background: #dce8ff;
    color: #2455a4;
    font-weight: 800;
    padding: 9px 12px;
    border-radius: 9px;
}

.passo p {
    margin-bottom: 0;
}

.valores {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    margin: 20px 0;
}

.valores div {
    background: white;
    border-radius: 12px;
    padding: 18px;
    text-align: center;
}

.valores span {
    color: #159b83;
    font-size: 20px;
    font-weight: 800;
}

.valores p {
    font-size: 13px;
    margin-bottom: 0;
}

.observacao {
    font-size: 12px;
}

.dica {
    background: #e4f8ef;
    border-radius: 16px;
    padding: 25px;
}

.dica h2 {
    color: #159b83;
}

@@media (max-width: 650px) {
    .cards,
    .valores {
        grid-template-columns: 1fr;
    }

    .cabecalho h1 {
        font-size: 28px;
    }
}
</style>
