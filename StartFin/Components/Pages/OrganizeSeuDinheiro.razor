    max-width: 1000px;
    margin: 0 auto;
    padding: 30px 15px 50px;
    color: #172b65;
}

.voltar {
    display: inline-block;
    color: #2455a4;
    text-decoration: none;
    font-weight: 700;
    margin-bottom: 25px;
}

.voltar:hover {
    text-decoration: underline;
}

.cabecalho {
    margin-bottom: 30px;
}

.etiqueta {
    color: #16b99a;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1.5px;
}

.cabecalho h1 {
    font-size: 34px;
    font-weight: 800;
    margin: 10px 0;
}

.cabecalho p,
.destaque p,
.card p,
.passo p,
.exemplo p,
.dica p {
    color: #647da8;
    line-height: 1.7;
}

.destaque,
